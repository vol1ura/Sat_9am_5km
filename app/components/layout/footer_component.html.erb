<footer class="mt-auto border-t border-line bg-surface-elevated" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only"><%= t 'navbars.bottom.s95' %></h2>
  <div class="mx-auto max-w-6xl px-4 py-10">
    <div class="grid gap-8 lg:grid-cols-4">
      <div>
        <%= link_to t('navbars.bottom.s95'), root_path, class: 'inline-flex items-center gap-2 text-ink no-underline hover:text-brand font-display font-semibold' %>
        <p class="mt-3 max-w-xs text-sm text-ink-muted"><%= t 'navbars.bottom.slogan' %></p>
        <%= link_to t('navbars.bottom.privacy_policy'), page_path(page: 'privacy-policy'), class: 'mt-2 inline-block text-sm text-ink-muted hover:text-brand' %>
      </div>

      <div class="grid grid-cols-1 min-[360px]:grid-cols-2 gap-8 lg:contents">
        <% Navigation::FOOTER_SECTIONS.each do |section| %>
          <div class="min-w-0">
            <h3 class="mb-3 text-xs font-semibold uppercase tracking-wide text-ink-muted">
              <%= section[:heading_key] == :sections ? t('navbars.bottom.headings.sections') : t('navbars.top.movement') %>
            </h3>
            <ul class="space-y-2 text-sm">
              <% section[:items].each do |item| %>
                <li><%= link_to nav_label(item[:key]), nav_path(item), class: 'text-ink-muted hover:text-brand' %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>

      <div>
        <h3 class="mb-3 text-xs font-semibold uppercase tracking-wide text-ink-muted"><%= t 'navbars.bottom.headings.connect' %></h3>
        <ul class="flex flex-wrap gap-2">
          <% contact_links.each do |link| %>
            <li>
              <% if link[:external] %>
                <%= external_link_to(link[:url], { class: social_icon_class, title: link[:title], aria: { label: link[:label] } }) do %>
                  <i class="<%= link[:icon] %>" aria-hidden="true"></i>
                <% end %>
              <% else %>
                <%= link_to link[:url], class: social_icon_class, title: link[:title], aria: { label: link[:label] } do %>
                  <i class="<%= link[:icon] %>" aria-hidden="true"></i>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>

    <p class="mt-8 border-t border-line pt-4 text-center text-xs text-ink-muted">
      © <%= Time.zone.today.year %>
      <% if top_level_domain == :ru %>
        <%= t 'navbars.bottom.ano' %>.
      <% else %>
        <%= t 'navbars.bottom.s95' %>.
      <% end %>
      <%= t 'navbars.bottom.copyright' %>
    </p>

    <% if top_level_domain == :ru %>
      <div class="mt-2 space-y-1 text-center text-xs text-ink-muted">
        <p>
          <%= t 'navbars.bottom.ano' %>
          · <%= t 'navbars.bottom.ogrn' %>: 1237700352713
          · <%= t 'navbars.bottom.inn' %>: 9721206702
          · <%= t 'navbars.bottom.kpp' %>: 772101001
          · <%= t 'navbars.bottom.registration_date' %>: 18.05.2023
        </p>
        <p>
          <%= t 'navbars.bottom.address' %>
          ·
          <%= external_link_to(ENV.fetch('INFO_EMAIL'), "mailto:#{ENV.fetch('INFO_EMAIL')}", class: 'text-ink-muted hover:text-brand') %>
        </p>
      </div>
    <% end %>
  </div>
</footer>
