<tr>
  <td class="cell-num-muted"><%= ((@page - 1) * RatingsController::PER_PAGE) + result_counter.next %></td>
  <% if @with_absolute_position %>
    <td class="cell-num"><%= result.ranked_position %></td>
  <% end %>
  <td class="cell-num-strong"><%= result.time_string %></td>
  <td><%= link_to result.athlete.name, result.athlete, class: 'athlete-link font-semibold' %></td>
  <td class="whitespace-nowrap"><%= link_to l(result.date), result.activity %></td>
  <td>
    <% club = result.athlete&.club %>
    <%= link_to club.name, club_path(club.slug) if club %>
  </td>
  <td><%= link_to result.activity.event_name, event_path(result.activity.event.code_name) %></td>
</tr>
