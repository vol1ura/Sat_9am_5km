<% head_info :description, t('.description') %>

<%= render 'hub_tabs' %>

<%= render Ui::PageHeaderComponent.new(
  title: head_info(:title, t(".#{@rating_type}.title")),
  description: t('.description'),
) %>

<div
  data-controller="table"
  data-table-url-value="/ratings/table"
  data-table-params-value="order,type">

  <div class="mb-4 flex gap-1 overflow-x-auto pb-1" role="tablist">
    <% RatingsController::RATINGS.each do |order| %>
      <%= button_tag t(".#{order}"),
                     type: 'button',
                     class: "whitespace-nowrap rounded-full px-3 py-1.5 text-sm font-medium #{order == @order ? 'active bg-accent text-accent-fg' : 'bg-surface-elevated text-ink-muted hover:text-ink'}",
                     data: {
                       table_target: 'tab',
                       action: 'click->table#switchTab',
                       order: order,
                       type: @rating_type,
                       description_title: t(".#{order}"),
                       description_text: t(".#{@rating_type}.description.#{order}"),
                     } %>
    <% end %>
  </div>

  <div class="mb-4 rounded-lg border border-line bg-surface-elevated p-4">
    <h2 class="mb-1 font-display text-lg font-semibold text-ink" data-table-target="descriptionTitle"><%= t(".#{@order}") %></h2>
    <p class="mb-0 text-sm text-ink-muted" data-table-target="descriptionText"><%= t(".#{@rating_type}.description.#{@order}") %></p>
  </div>

  <div class="data-table-shell">
    <table class="data-table sm:table-fixed">
      <thead>
        <tr>
          <th class="cell-num-muted w-9 shrink-0 sm:w-12">#</th>
          <th class="min-w-0"><%= t '.name' %></th>
          <th class="cell-num-strong w-14 shrink-0 sm:w-28"><%= t '.total' %></th>
          <th class="hidden-on-phone w-48"><%= t '.club' %></th>
        </tr>
      </thead>
      <tbody data-table-target="content">
        <%= render 'loading_indicator', colspan: 4 %>
      </tbody>
    </table>
  </div>
</div>
