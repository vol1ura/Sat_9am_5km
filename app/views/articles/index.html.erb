<% content_for :title, t('.title') %>
<% content_for :description, t('.description') %>

<div class="page-container my-6 md:my-8">
  <%= render Ui::PageHeaderComponent.new(
    title: t('.title'),
    description: tag.p(t('.description'), class: 'max-w-2xl text-base leading-relaxed')
  ) %>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <%= render Ui::CardComponent.new(class: 'h-full', hover: true) do %>
      <h2 class="mb-2 font-display text-lg font-semibold text-ink">
        <%= link_to t('.first_run.title'), article_path(page: 'first-run'), class: 'stretched-link text-ink no-underline hover:text-brand' %>
      </h2>
      <p class="mb-0 text-sm leading-relaxed text-ink-muted"><%= t('.first_run.description') %></p>
    <% end %>

    <%= render Ui::CardComponent.new(class: 'h-full', hover: true) do %>
      <h2 class="mb-2 font-display text-lg font-semibold text-ink">
        <%= link_to t('.weight_and_time.title'), article_path(page: 'weight-and-time'), class: 'stretched-link text-ink no-underline hover:text-brand' %>
      </h2>
      <p class="mb-0 text-sm leading-relaxed text-ink-muted"><%= t('.weight_and_time.description') %></p>
    <% end %>
  </div>
</div>
