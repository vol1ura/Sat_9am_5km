<% head_info :description, t('.description') %>

<div class="page-container my-6 md:my-8">
  <%= render Ui::PageHeaderComponent.new(
    title: head_info(:title, t('.title_html', year: 5.weeks.from_now.year)),
  ) %>

  <div class="mx-auto max-w-md">
    <div class="data-table-shell">
      <table class="data-table">
        <thead>
          <tr>
            <th><%= t 'activities.index.event' %></th>
            <th class="cell-num"><%= t '.time' %></th>
          </tr>
        </thead>
        <tbody>
          <% additional_events = Rails.configuration.additional_events %>
          <% @country_events.where(code_name: additional_events.keys).each do |event| %>
            <tr>
              <td><%= link_to event.name, event_path(event.code_name) %></td>
              <td class="cell-num"><%= additional_events[event.code_name.to_sym] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
