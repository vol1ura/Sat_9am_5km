<% head_info :title, 'Бег, спасающий жизни - благотворительное мероприятие и забег в Кузьминках' %>
<% head_info :description, 'Ежегодное мероприятие в Кузьминках, которое проводится в рамках пробежки С95. Главная цель – информирование участников о донорстве костного мозга и вступление участников в регистр потенциальных доноров.' %>
<% head_info :og_image, image_url('/images/donor.webp') %>

<% timeline_items = [
  { time: '8:30', title: 'Сбор участников', icon: 'users', tone: :brand },
  { time: '8:45', title: 'Разминка и брифинг', icon: 'dumbbell', tone: :success },
  { time: '9:00', title: 'Старт забега', icon: 'flag', tone: :brand, bold: true },
  { time: '10:00', title: 'Ориентировочный финиш замыкающих', icon: 'flag-checkered', tone: :success },
  { time: '10:15', title: 'Лекция о донорстве. Проводит: <em>Алёна Фирсова</em> — ведущий специалист группы рекрутинга доноров НМИЦ гематологии', icon: 'microphone', tone: :brand },
  { time: '10:00 - 12:00', title: 'Типирование на вступление в реестр доноров костного мозга', icon: 'heart', tone: :accent, bold: true },
] %>

<div class="-mx-4 -mt-6 mb-6 overflow-hidden bg-gradient-to-br from-brand-fill via-brand to-info py-14 md:-mx-0 md:rounded-xl">
  <div class="relative mx-auto max-w-3xl px-4 text-center">
    <h1 class="mb-4 font-display text-3xl font-bold text-brand-fg drop-shadow md:text-4xl">
      <i class="fas fa-heart text-accent"></i>
      Бег, спасающий жизни
    </h1>
    <p class="mb-3 text-lg text-brand-fg/90">
      Ежегодное мероприятие в Кузьминках, которое проводится в рамках пробежки С95
    </p>
    <p class="text-brand-fg/80">
      Главная цель – информирование участников о донорстве костного мозга
      и вступление участников в регистр потенциальных доноров
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <span class="inline-flex items-center gap-2 rounded-full bg-surface-elevated px-4 py-2 text-sm text-ink">
        <i class="fas fa-calendar-alt text-info"></i> 6 сентября 2025
      </span>
      <a class="inline-flex items-center gap-2 rounded-full bg-surface-elevated px-4 py-2 text-sm text-ink no-underline hover:text-accent" href="https://yandex.ru/maps/-/CHh4UY2G" target="_blank" rel="noopener">
        <i class="fas fa-map-marker-alt text-success"></i> Парк Кузьминки
      </a>
    </div>
  </div>
</div>

<div class="mx-auto max-w-2xl space-y-6">
  <div class="overflow-hidden rounded-xl border border-line bg-surface shadow-md">
    <%= image_tag '/images/donor.webp', alt: 'Бег, спасающий жизни', class: 'w-full object-cover' %>
    <p class="bg-ink/60 px-4 py-3 text-center font-semibold text-brand-fg">Бег, спасающий жизни — больше, чем спорт</p>
  </div>

  <%= render Ui::CardComponent.new do %>
    <h2 class="mb-4 text-center text-lg font-semibold text-info">
      <i class="fas fa-info-circle mr-2"></i>
      Дата и место проведения
    </h2>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <div class="flex items-center gap-3 rounded-lg bg-info p-4 text-info-fg">
        <i class="fas fa-calendar-check text-3xl"></i>
        <div>
          <h3 class="mb-1 font-medium">Дата проведения</h3>
          <p class="mb-0 font-bold">6 сентября 2025 года</p>
        </div>
      </div>
      <div class="relative flex items-center gap-3 rounded-lg bg-success p-4 text-success-fg">
        <i class="fas fa-map-marked-alt text-3xl"></i>
        <div>
          <h3 class="mb-1 font-medium">Локация</h3>
          <a class="font-bold text-success-fg no-underline hover:opacity-90" href="https://yandex.ru/maps/-/CHh4UY2G" target="_blank" rel="noopener">Парк Кузьминки (главная сцена)</a>
        </div>
      </div>
    </div>
  <% end %>

  <%= render Ui::CardComponent.new do %>
    <h2 class="mb-6 text-center text-lg font-semibold text-ink">
      <i class="fas fa-clock mr-2 text-brand"></i>
      Программа мероприятия
    </h2>
    <div class="relative space-y-4 border-l-2 border-brand/30 pl-8">
      <% timeline_items.each do |item| %>
        <% dot_class = { brand: 'bg-brand-fill', success: 'bg-success', accent: 'bg-accent' }[item[:tone]] %>
        <% border_class = { brand: 'border-brand', success: 'border-success', accent: 'border-accent' }[item[:tone]] %>
        <div class="relative">
          <span class="absolute -left-[2.4rem] flex h-6 w-6 items-center justify-center rounded-full <%= dot_class %>">
            <i class="fas fa-<%= item[:icon] %> text-xs text-brand-fg"></i>
          </span>
          <div class="rounded-lg border-l-4 <%= border_class %> bg-surface-elevated p-3 shadow-sm">
            <h3 class="mb-1 font-bold text-brand"><%= item[:time] %></h3>
            <p class="mb-0 <%= 'font-semibold' if item[:bold] %>"><%= item[:title].html_safe %></p>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= render Ui::CardComponent.new do %>
    <h2 class="mb-4 text-center text-lg font-semibold text-success">
      <i class="fas fa-shoe-prints mr-2"></i>
      Как участвовать
    </h2>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <div class="rounded-lg border-2 border-info/40 bg-surface-elevated p-4 text-center">
        <i class="fas fa-running mb-3 text-4xl text-success"></i>
        <h3 class="mb-3 font-semibold text-success">Пробежка или прогулка</h3>
        <p class="mb-0 text-sm text-ink-muted">
          Дистанцию можно пробежать в любом комфортном темпе или пройти,
          если вы только делаете первые шаги в беге и 5 километров – это слишком сложно.
        </p>
      </div>
      <div class="rounded-lg border-2 border-brand/30 bg-surface-elevated p-4 text-center">
        <i class="fab fa-telegram-plane mb-3 text-4xl text-brand"></i>
        <h3 class="mb-3 font-semibold text-brand">Регистрация</h3>
        <p class="mb-4 text-sm text-ink-muted">
          Для попадания в протокол забега нужно зарегистрироваться на сайте
          (это делается один раз на все наши мероприятия).
        </p>
        <%= render Ui::ButtonComponent.new(variant: :brand, size: :lg, href: new_user_registration_path) do %>
          Зарегистрироваться
        <% end %>
      </div>
    </div>
    <div class="mt-4 flex items-start gap-3 rounded-lg border border-warning/40 bg-warning-subtle p-4">
      <i class="fas fa-qrcode text-2xl text-warning"></i>
      <div>
        <h3 class="mb-1 font-semibold text-ink">После финиша</h3>
        <p class="mb-0 text-sm text-ink-muted">Предъявите волонтёру QR-код, полученный в боте. Так ваше имя будет в списке финишёров и вы увидите свой результат.</p>
      </div>
    </div>
  <% end %>

  <%= render Ui::CardComponent.new do %>
    <h2 class="mb-4 text-center text-lg font-semibold text-brand">
      <i class="fas fa-handshake mr-2"></i>
      Организаторы и партнёры
    </h2>
    <p class="mb-4 text-center text-ink-muted">Забег проводится и поддерживается:</p>
    <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
      <div class="rounded-lg bg-brand-fill p-4 text-brand-fg">
        <%= link_to root_path, class: 'font-semibold text-brand-fg no-underline hover:opacity-90' do %>
          <i class="fas fa-home mr-2"></i> Платформа С95
        <% end %>
        <p class="mb-0 mt-1 text-sm text-brand-fg/80">Организатор</p>
      </div>
      <div class="rounded-lg bg-ink p-4 text-brand-fg">
        <%= link_to 'https://t.me/mission_42_2', target: '_blank', rel: 'noopener', class: 'font-semibold text-brand-fg no-underline hover:opacity-90' do %>
          <i class="fab fa-telegram-plane mr-2"></i> Mission 42.2
        <% end %>
        <p class="mb-0 mt-1 text-sm text-brand-fg/80">Беговой клуб</p>
      </div>
      <div class="rounded-lg bg-success p-4 text-success-fg">
        <%= link_to 'https://park-kuzminki.ru/', target: '_blank', rel: 'noopener', class: 'font-semibold text-success-fg no-underline hover:opacity-90' do %>
          <i class="fas fa-tree mr-2"></i> Администрация парка Кузьминки-Люблино
        <% end %>
        <p class="mb-0 mt-1 text-sm text-success-fg/80">Место проведения</p>
      </div>
      <div class="rounded-lg bg-accent p-4 text-accent-fg">
        <%= link_to 'https://blood.ru/', target: '_blank', rel: 'noopener', class: 'font-semibold text-accent-fg no-underline hover:opacity-90' do %>
          <i class="fas fa-heartbeat mr-2"></i> НМИЦ Гематологии
        <% end %>
        <p class="mb-0 mt-1 text-sm text-accent-fg/80">Медицинский партнёр</p>
      </div>
      <% if (ws_club = Club.find_by(id: 214)) %>
        <div class="col-span-full rounded-lg bg-warning-subtle p-4 text-center">
          <%= link_to club_path(ws_club.slug), class: 'font-semibold text-ink no-underline hover:text-accent' do %>
            <i class="fas fa-balance-scale mr-2"></i> Юридическая фирма White Stone
          <% end %>
          <p class="mb-0 mt-1 text-sm text-ink-muted">Информационная и юридическая поддержка</p>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= render Ui::CardComponent.new do %>
    <div class="text-center">
      <i class="fas fa-globe mb-4 text-5xl text-brand"></i>
      <h2 class="mb-4 text-lg font-semibold text-brand">
        <i class="fas fa-users mr-2"></i>
        О движении С95
      </h2>
      <p class="mb-4 leading-relaxed text-ink-muted">
        Как и любая благотворительность – мы <strong class="text-ink">не разовая акция</strong>, а регулярное мероприятие,
        проводимое каждую субботу почти в
        <span class="inline-flex items-center rounded-full bg-brand-fill px-2 py-1 text-sm text-brand-fg">30 парках</span>
        России, Белоруссии и Сербии.
      </p>
      <p class="mb-6 text-ink-muted">
        Выбрать ближайший парк можно на карте и присоединиться к пробежкам или волонтёрству в любое время.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <%= render Ui::ButtonComponent.new(variant: :brand, size: :lg, href: events_path) do %>
          <i class="fas fa-map-marked-alt"></i> Мероприятия
        <% end %>
        <%= render Ui::ButtonComponent.new(variant: :primary, size: :lg, href: activities_path) do %>
          <i class="fas fa-chart-bar"></i> Результаты
        <% end %>
      </div>
    </div>
  <% end %>

  <div id="results" class="overflow-hidden rounded-xl border-2 border-accent bg-surface shadow-md">
    <div class="bg-accent px-4 py-6 text-center text-accent-fg">
      <h2 class="mb-2 text-2xl font-bold">Результаты в прошлые годы</h2>
      <p class="mb-0">Бег, спасающий жизни</p>
    </div>
    <div class="p-4">
      <h3 class="mb-6 text-center text-2xl font-bold text-accent">2024 год</h3>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        <div class="rounded-lg bg-brand-fill p-4 text-center text-brand-fg">
          <i class="fas fa-running mb-2 text-3xl"></i>
          <div class="font-display text-4xl font-bold tabular-nums">250</div>
          <h4 class="mb-0 font-medium">участников</h4>
          <p class="mb-0 text-sm text-brand-fg/80">присоединились к забегу</p>
        </div>
        <div class="rounded-lg bg-success p-4 text-center text-success-fg">
          <i class="fas fa-hands-helping mb-2 text-3xl"></i>
          <div class="font-display text-4xl font-bold tabular-nums">42</div>
          <h4 class="mb-0 font-medium">волонтёра</h4>
          <p class="mb-0 text-sm text-success-fg/80">помогали в организации</p>
        </div>
        <div class="rounded-lg bg-accent p-4 text-center text-accent-fg">
          <i class="fas fa-heart mb-2 text-3xl"></i>
          <div class="font-display text-4xl font-bold tabular-nums">38</div>
          <h4 class="mb-0 font-medium">новых доноров</h4>
          <p class="mb-0 text-sm text-accent-fg/80">вступили в реестр</p>
        </div>
      </div>
      <div class="mt-6 rounded-lg border border-warning/40 bg-warning-subtle p-4 text-center">
        <i class="fas fa-heartbeat mb-2 text-2xl text-accent"></i>
        <h4 class="mb-2 font-semibold text-brand">38 потенциальных спасателей жизни!</h4>
        <p class="mb-0 text-sm text-ink-muted">
          Каждый новый донор костного мозга может спасти жизнь человека, страдающего от заболевания крови
        </p>
      </div>
    </div>
  </div>
</div>
