<% head_info :description, t('.description') %>

<div class="page-container my-6 md:my-8">
  <article class="article">
    <header class="article__header">
      <h1><%= head_info :title, t('navbars.about_s95.rules') %></h1>
    </header>

    <div class="article__body">
      <section>
        <ul class="divide-y divide-line border-y border-line">
          <li class="py-3"><%= t '.register_with_bot_html', link: new_user_registration_path %></li>
          <li class="py-3"><%= t '.come_to_s95_html', link: events_path %></li>
          <li class="py-3"><%= t '.scan_barcodes' %></li>
          <li class="py-3"><%= t '.return_position_card' %></li>
        </ul>
      </section>

      <section>
        <h2><%= t '.faq' %></h2>
        <div class="divide-y divide-line border-y border-line">
          <details class="group py-1">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-2 py-3 font-medium text-ink [&::-webkit-details-marker]:hidden">
              <%= t '.about_markers.question' %>
              <i class="fa-solid fa-chevron-down text-ink-muted transition-transform group-open:rotate-180"></i>
            </summary>
            <div class="pb-3 text-ink-muted"><%= t '.about_markers.answer' %></div>
          </details>
          <details class="group py-1">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-2 py-3 font-medium text-ink [&::-webkit-details-marker]:hidden">
              <%= t '.about_registering.question' %>
              <i class="fa-solid fa-chevron-down text-ink-muted transition-transform group-open:rotate-180"></i>
            </summary>
            <div class="pb-3 text-ink-muted"><%= t '.about_registering.answer_html', link: new_user_registration_path %></div>
          </details>
          <details class="group py-1">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-2 py-3 font-medium text-ink [&::-webkit-details-marker]:hidden">
              <%= t '.about_participation.question' %>
              <i class="fa-solid fa-chevron-down text-ink-muted transition-transform group-open:rotate-180"></i>
            </summary>
            <div class="pb-3 text-ink-muted"><%= t '.about_participation.answer' %></div>
          </details>
          <details class="group py-1">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-2 py-3 font-medium text-ink [&::-webkit-details-marker]:hidden">
              <%= t '.about_barcode.question' %>
              <i class="fa-solid fa-chevron-down text-ink-muted transition-transform group-open:rotate-180"></i>
            </summary>
            <div class="pb-3 text-ink-muted"><%= t '.about_barcode.answer' %></div>
          </details>
          <details class="group py-1">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-2 py-3 font-medium text-ink [&::-webkit-details-marker]:hidden">
              <%= t '.about_things.question' %>
              <i class="fa-solid fa-chevron-down text-ink-muted transition-transform group-open:rotate-180"></i>
            </summary>
            <div class="pb-3 text-ink-muted"><%= t '.about_things.answer' %></div>
          </details>
          <details class="group py-1">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-2 py-3 font-medium text-ink [&::-webkit-details-marker]:hidden">
              <%= t '.personal_info.question' %>
              <i class="fa-solid fa-chevron-down text-ink-muted transition-transform group-open:rotate-180"></i>
            </summary>
            <div class="pb-3 text-ink-muted"><%= t '.personal_info.answer_html' %></div>
          </details>
        </div>
      </section>
    </div>
  </article>
</div>
