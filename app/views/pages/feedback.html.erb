<div class="page-container my-6 md:my-8">
  <article class="article">
    <header class="article__header">
      <h1><%= head_info :title, t('navbars.about_s95.feedback') %></h1>
      <p class="mt-3 text-base leading-relaxed text-ink-muted"><%= head_info :description, t('.description') %></p>
    </header>

    <div class="article__body">
      <%= render Ui::CardComponent.new(class: 'mb-4') do %>
        <%= form_with url: submit_feedback_pages_path, local: true do |form| %>
          <div class="mb-3">
            <%= form.label :message, t('.message_label'), class: 'block text-sm font-medium text-ink' %>
            <%= form.text_area :message,
                  class: form_input_class(extra: 'min-h-[10rem]'),
                  placeholder: t('.placeholder'), maxlength: PagesController::MAX_FEEDBACK_SIZE, rows: 7, required: true %>
          </div>

          <% unless current_user %>
            <div class="contact hidden required">
              <%= form.label :contact, 'Required your contact', class: 'block text-sm font-medium text-ink' %>
              <%= form.text_field :contact, placeholder: t('.contact_placeholder'), autocomplete: 'off',
                    class: form_input_class %>
            </div>

            <div class="contact mb-3 required">
              <%= form.label :user_contact, t('.contact_label'), class: 'block text-sm font-medium text-ink' %>
              <%= form.text_field :user_contact,
                    class: form_input_class,
                    placeholder: t('.contact_placeholder'), maxlength: 255, autocomplete: 'off' %>
              <div class="mt-1 text-sm text-ink-muted"><%= t '.contact_hint' %></div>
            </div>
          <% end %>

          <% unless policy_already_accepted? %>
            <div class="mb-3 flex items-start gap-2">
              <%= form.check_box :policy_accepted, class: 'mt-0.5 rounded border-line text-accent focus:ring-focus-ring', required: true %>
              <%= form.label :policy_accepted, class: 'text-sm text-ink' do %>
                <%= t('.policy_consent_html', link: page_path(page: 'privacy-policy')) %>
              <% end %>
            </div>
          <% end %>

          <%= render Ui::ButtonComponent.new(variant: :primary, type: 'submit', class: 'mt-2', data: { turbo_confirm: t('.confirm') }, label: t('.submit')) %>
        <% end %>
      <% end %>

      <p class="text-sm text-ink-muted"><%= t '.other_contacts_html', our_email: ENV.fetch('INFO_EMAIL') %></p>
    </div>
  </article>
</div>
