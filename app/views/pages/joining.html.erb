<% head_info :title, t('navbars.about_s95.joining') %>
<% head_info :description, t('.description') %>

<div class="page-container my-6 md:my-8">
  <article class="article">
    <header class="article__header">
      <h1><%= t '.title' %></h1>
    </header>

    <div class="article__body">
      <%= t '.body_html', info_email: ENV.fetch('INFO_EMAIL'), badges_link: badges_path %>

      <% if top_level_domain == :ru %>
        <section>
          <h3><%= t '.support.title' %></h3>
          <div class="flex flex-col items-center gap-2 sm:flex-row sm:items-start sm:justify-between md:gap-3">
            <img src="/images/msk_grant.webp" alt="Гранты Мэра Москвы" class="order-0 w-[250px] max-w-full sm:order-1">
            <div class="order-1 sm:order-0">
              <p class="mb-0"><%= t '.support.description' %></p>
              <p><%= t '.support.acknowledgment' %></p>
            </div>
          </div>
        </section>
      <% end %>
    </div>
  </article>
</div>
