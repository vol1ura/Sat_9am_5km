      <%= external_link_to 'https://t.me/parkrun' do %>
        <%= image_tag '/images/partners/pro_parkrun.png', class: 'h-24 opacity-90 transition-transform hover:-translate-y-1 hover:opacity-100 sm:h-36', alt: 'Pro parkrun', loading: 'lazy' %>
      <% end %>
      <% if top_level_domain == :ru %>
        <%= external_link_to 'https://rununion.ru/clubs/6' do %>
          <%= image_tag '/images/partners/run_union.png', class: 'h-24 opacity-90 transition-transform hover:-translate-y-1 hover:opacity-100 sm:h-36', alt: 'Союз любителей бега', loading: 'lazy' %>
        <% end %>
      <% end %>
      <% if top_level_domain == :rs %>
