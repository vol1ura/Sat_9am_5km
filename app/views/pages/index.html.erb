<%# Hero — full-bleed, warm morning overlay %>
<section class="relative min-h-[min(100vh-4rem,52rem)] w-full overflow-hidden">
  <img
    src="/images/hero-bg.webp"
    alt=""
    class="absolute inset-0 h-full w-full object-cover object-bottom"
    aria-hidden="true"
    loading="eager">
  <div class="hero-overlay absolute inset-0" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto flex min-h-[inherit] max-w-6xl items-center justify-center px-4 py-10 sm:py-16 lg:justify-end">
    <div class="w-full max-w-xl rounded-xl border border-white/20 bg-white/10 p-6 shadow-2xl backdrop-blur-md sm:p-8">
      <h1 class="font-display text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">
        <%= t '.hero_title' %>
        <span class="text-gradient-hero"><%= t '.hero_title_accent' %></span>
      </h1>
      <p class="mt-4 text-lg text-white/90 sm:text-xl"><%= t '.hero_subtitle' %></p>
      <div class="mt-6 flex flex-wrap gap-3">
        <% if current_user&.athlete %>
          <%= render Ui::ButtonComponent.new(variant: :accent, size: :lg, rounded: :full, href: athlete_path(current_user.athlete)) do %>
            <%= t '.my_profile' %>
          <% end %>
        <% else %>
          <%= render Ui::ButtonComponent.new(variant: :accent, size: :lg, rounded: :full, href: new_user_registration_path) do %>
            <%= t '.registration' %>
          <% end %>
        <% end %>
        <%= render Ui::ButtonComponent.new(
              variant: :secondary,
              size: :lg,
              rounded: :full,
              href: activities_path,
              class: 'border-white/40 bg-white/10 text-white backdrop-blur-sm hover:bg-white/20',
            ) do %>
          <%= t '.results' %>
        <% end %>
        <%= render Ui::ButtonComponent.new(
              variant: :secondary,
              size: :lg,
              rounded: :full,
              href: events_path,
              class: 'border-white/40 bg-white/10 text-white backdrop-blur-sm hover:bg-white/20',
            ) do %>
          <%= t '.find_event' %>
        <% end %>
      </div>
    </div>
  </div>
</section>

<%# Upcoming Saturday — promoted above marketing content %>
<% if @jubilee_events.present? || @funrun_badges.present? %>
  <section class="border-b border-line bg-surface-elevated py-10 sm:py-12">
    <div class="mx-auto max-w-2xl px-4">
      <%= render Ui::SectionHeadingComponent.new(
            title: t('.upcoming_events_title'),
            kicker: l(@next_saturday, format: :brief),
          ) %>
      <ul class="space-y-3">
        <% @funrun_badges.each do |badge| %>
          <li>
            <%= render Ui::CardComponent.new(hover: true, class: 'relative border-l-4 border-accent') do %>
              <div class="flex items-center gap-4">
                <%= image_tag badge.image.variant(:thumb), class: 'h-16 w-16 shrink-0 rounded-lg object-cover', alt: 'FunRun badge' %>
                <%= link_to badge.name, badge, class: 'stretched-link font-semibold text-ink no-underline hover:text-link' %>
              </div>
            <% end %>
          </li>
        <% end %>
        <% @jubilee_events.each do |event, activity_number| %>
          <li>
            <%= render Ui::CardComponent.new(hover: true, class: 'relative border-l-4 border-accent') do %>
              <div class="flex items-center gap-4">
                <div class="flex h-16 w-16 shrink-0 flex-col items-center justify-center rounded-full border-2 border-accent bg-accent-subtle text-center text-ink">
                  <div class="text-xs capitalize leading-tight"><%= t 'activerecord.models.activity.one' %></div>
                  <div class="font-display text-sm leading-tight">№<%= activity_number %></div>
                </div>
                <%= link_to event.name, event_path(event.code_name), class: 'stretched-link font-semibold text-ink no-underline hover:text-link' %>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  </section>
<% end %>

<%# Getting started + Why S95 %>
<section class="bg-canvas py-10 sm:py-14">
  <div class="mx-auto max-w-6xl px-4">
    <%= render Ui::SectionHeadingComponent.new(title: t('.getting_started.title')) %>

    <ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <% [
        { title: t('.getting_started.registration.title'), description: t('.getting_started.registration.description'), href: new_user_session_path },
        { title: t('.getting_started.choose_run.title'), description: t('.getting_started.choose_run.description'), href: events_path },
        { title: t('.getting_started.come_saturday.title'), description: t('.getting_started.come_saturday.description'), href: page_path(page: 'rules') },
        { title: t('.getting_started.track_progress.title'), description: t('.getting_started.track_progress.description'), href: ratings_path },
      ].each.with_index(1) do |item, idx| %>
        <li>
          <%= render Ui::CardComponent.new(hover: true, class: 'relative h-full transition-transform duration-200 hover:-translate-y-0.5 hover:shadow-lg') do %>
            <span class="step-badge" aria-hidden="true"><%= idx %></span>
            <h3 class="mt-3 font-display text-base font-semibold text-ink">
              <%= link_to item[:title], item[:href], class: 'stretched-link text-ink no-underline hover:text-link' %>
            </h3>
            <p class="mt-2 mb-0 text-sm text-ink-muted"><%= item[:description] %></p>
          <% end %>
        </li>
      <% end %>
    </ol>

    <div class="mt-10">
      <%= render Ui::SectionHeadingComponent.new(title: t('.why_s95.title')) %>
      <div class="grid gap-4 sm:grid-cols-3">
      <% [
        { title: t('.why_s95.for_everyone.title'), description: t('.why_s95.for_everyone.description'), icon: 'fa-users' },
        { title: t('.why_s95.community.title'), description: t('.why_s95.community.description'), icon: 'fa-heart' },
        { title: t('.why_s95.free.title'), description: t('.why_s95.free.description'), icon: 'fa-gift' },
      ].each do |item| %>
        <%= render Ui::CardComponent.new(class: 'h-full') do %>
          <i class="fa-solid <%= item[:icon] %> text-xl text-brand" aria-hidden="true"></i>
          <h3 class="mt-3 font-display font-semibold text-brand"><%= item[:title] %></h3>
          <p class="mt-1 mb-0 text-sm text-ink-muted"><%= item[:description] %></p>
        <% end %>
      <% end %>
      </div>
    </div>
  </div>
</section>

<%# Marquee %>
<% marquee_items = t('.marquee_items') %>
<section class="home-marquee overflow-hidden border-y border-line bg-brand-fill py-3 text-brand-fg shadow-md">
  <div class="home-marquee__inner flex w-max items-center uppercase">
    <% 2.times do %>
      <div class="home-marquee__track flex shrink-0 items-center gap-7 px-6 text-sm font-semibold tracking-widest sm:text-base">
        <% marquee_items.each do |item| %>
          <span class="home-marquee__item"><%= item %></span>
          <span class="home-marquee__dot opacity-60" aria-hidden="true">•</span>
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<%# Stories carousel %>
<section class="bg-canvas py-10 sm:py-14">
  <div class="mx-auto max-w-4xl px-4">
    <%= render Ui::SectionHeadingComponent.new(title: t('.stories.title')) %>
    <%
      stories = t '.stories.content'
      athletes = Athlete.includes(:event, user: { image_attachment: :blob }).where(id: stories.keys).shuffle
    %>
    <div data-controller="carousel" class="relative">
      <div class="overflow-hidden">
        <% athletes.each_with_index do |athlete, idx| %>
          <div data-carousel-target="slide" class="<%= idx.zero? ? '' : 'hidden' %>">
            <%= render Ui::CardComponent.new(class: 'relative mx-1 border-line bg-surface-elevated') do %>
              <span class="pointer-events-none absolute top-2 left-4 font-display text-6xl leading-none text-accent/20" aria-hidden="true">“</span>
              <figure class="relative flex flex-col items-center gap-4 md:flex-row md:items-start">
                <div class="shrink-0">
                  <%= image_tag user_image_path(athlete.user), class: 'h-24 w-24 shrink-0 rounded-full object-cover ring-2 ring-line', alt: athlete.name, loading: 'lazy' %>
                </div>
                <figcaption class="min-w-0 flex-1 text-center md:text-left">
                  <blockquote class="m-0">
                    <p class="text-base italic text-ink sm:text-lg"><%= stories[athlete.id] %></p>
                  </blockquote>
                  <cite class="mt-3 block text-sm not-italic text-ink-muted">
                    <%= link_to athlete.name, athlete, class: 'font-semibold no-underline' %>,
                    <%= athlete.event&.name %>
                  </cite>
                </figcaption>
              </figure>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="mt-4 flex items-center justify-center gap-4">
        <button
          type="button"
          class="flex h-10 w-10 items-center justify-center rounded-full border border-line bg-surface text-ink transition-colors hover:bg-accent-subtle"
          data-action="carousel#prev"
          aria-label="<%= t '.stories.previous' %>">
          <i class="fa-solid fa-chevron-left text-sm" aria-hidden="true"></i>
        </button>

        <div class="flex gap-2" role="tablist" aria-label="<%= t '.stories.title' %>">
          <% athletes.each_with_index do |athlete, idx| %>
            <button
              type="button"
              role="tab"
              data-carousel-target="indicator"
              data-index="<%= idx %>"
              data-action="carousel#showSlide"
              aria-label="<%= athlete.name %>"
              aria-current="<%= idx.zero? ? 'true' : 'false' %>"
              class="h-2.5 w-2.5 rounded-full transition-colors <%= idx.zero? ? 'bg-accent' : 'bg-line' %>">
            </button>
          <% end %>
        </div>

        <button
          type="button"
          class="flex h-10 w-10 items-center justify-center rounded-full border border-line bg-surface text-ink transition-colors hover:bg-accent-subtle"
          data-action="carousel#next"
          aria-label="<%= t '.stories.next' %>">
          <i class="fa-solid fa-chevron-right text-sm" aria-hidden="true"></i>
        </button>
      </div>
    </div>
  </div>
</section>

<%# S95 in numbers %>
<section class="border-t border-line bg-canvas py-10 sm:py-14">
  <div class="mx-auto max-w-6xl px-4">
    <%= render Ui::StatShowcaseComponent.new(
          title: t('.community_stats.title'),
          stats: [
            { label: t('.community_stats.athletes'), value: @country_stats[:athletes], href: ratings_path },
            { label: t('.community_stats.volunteers'), value: @country_stats[:volunteers], href: ratings_path(type: :volunteers) },
            { label: t('.community_stats.events'), value: @country_stats[:events], href: events_path },
            { label: t('.community_stats.activities'), value: @country_stats[:activities], href: activities_path },
            { label: t('.community_stats.finishes'), value: @country_stats[:finishes], href: activities_path },
            { label: t('.community_stats.volunteering'), value: @country_stats[:volunteering] },
          ],
        ) %>
  </div>
</section>

<%# Volunteer app %>
<section id="app" class="surface-gradient-info py-10 sm:py-14" data-controller="carousel">
  <div class="mx-auto max-w-6xl px-4">
    <%= render Ui::SectionHeadingComponent.new(title: t('.volunteer_app.title')) %>

    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] lg:items-center">
      <div class="flex justify-center">
        <div class="relative rounded-3xl p-2">
          <%= image_tag '/images/app/mobile_app_1.png',
                        class: 'max-h-96 w-auto rounded-2xl shadow-xl transition-opacity duration-200',
                        alt: t('.volunteer_app.title'),
                        data: { carousel_target: 'image' } %>
        </div>
      </div>

      <ul class="space-y-2">
        <% [
          { icon: 'fa-stopwatch', key: 'timer', index: 0 },
          { icon: 'fa-qrcode', key: 'scanner', index: 1 },
          { icon: 'fa-cloud-arrow-up', key: 'upload', index: 2 },
          { icon: 'fa-satellite-dish', key: 'live_results', index: 3 },
          { icon: 'fa-chart-bar', key: 'stats', index: 4 },
        ].each do |feature| %>
          <li
            class="cursor-pointer rounded-lg border border-transparent p-3 transition-colors hover:bg-surface/60 <%= 'feature-active' if feature[:index].zero? %>"
            data-carousel-target="feature"
            data-index="<%= feature[:index] %>"
            data-action="click->carousel#showSlide">
            <div class="flex items-start gap-3">
              <i class="fa-solid <%= feature[:icon] %> mt-0.5 text-xl text-brand" aria-hidden="true"></i>
              <div>
                <h3 class="font-display text-base font-semibold text-ink"><%= t ".volunteer_app.features.#{feature[:key]}.title" %></h3>
                <p class="mb-0 text-sm text-ink-muted"><%= t ".volunteer_app.features.#{feature[:key]}.description" %></p>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <%= external_link_to 'https://apps.apple.com/app/id6760978429' do %>
        <%= image_tag '/images/app/app-store.png', class: 'h-10 w-auto', alt: t('.volunteer_app.download_app_store') %>
      <% end %>
      <%= external_link_to 'https://appgallery.huawei.com/app/C114915605' do %>
        <%= image_tag "/images/app/#{top_level_domain == :rs ? 'app-gallery-rs.png' : 'app-gallery-ru.svg'}", class: 'h-10 w-auto', alt: t('.volunteer_app.download_app_gallery') %>
      <% end %>
      <% if top_level_domain == :ru %>
        <%= external_link_to 'https://www.rustore.ru/catalog/app/ru.s95.app?rsm=1&mt_link_id=l394r2' do %>
          <%= image_tag '/images/app/ru-store.svg', class: 'h-10 w-auto', alt: t('.volunteer_app.download_rustore') %>
        <% end %>
      <% end %>
      <%= link_to app_pages_path, data: { turbo_prefetch: false } do %>
        <%= image_tag '/images/app/apk.svg', class: 'h-10 w-auto', alt: t('.volunteer_app.download_apk') %>
      <% end %>
    </div>
  </div>
</section>

<% unless user_signed_in? %>
  <section class="bg-canvas py-10 sm:py-14">
    <div class="mx-auto max-w-6xl px-4">
      <%= render Ui::CtaBandComponent.new(
            title: t('.cta_band.title'),
            description: t('.cta_band.description'),
            href: new_user_registration_path,
            label: t('.registration'),
          ) %>
    </div>
  </section>
<% end %>

<%# Partners %>
<section class="relative overflow-hidden bg-canvas border-t border-line pb-24 pt-10 sm:pt-12">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute left-1/2 top-1/4 h-48 w-48 -translate-x-[calc(50%+4rem)] rounded-full bg-brand/25 blur-3xl dark:bg-brand/15"></div>
    <div class="absolute left-1/2 bottom-1/4 h-56 w-56 translate-x-[calc(50%+3rem)] rounded-full bg-accent/20 blur-3xl dark:bg-accent/10"></div>
  </div>

  <div class="relative mx-auto max-w-6xl px-4">
    <%= render Ui::SectionHeadingComponent.new(title: t('.our_partners')) %>
    <div class="flex flex-wrap items-center justify-center gap-6 sm:gap-8">
      <%= external_link_to 'https://t.me/parkrun' do %>
        <%= image_tag '/images/partners/pro_parkrun.png', class: 'h-24 opacity-90 transition-transform hover:-translate-y-1 hover:opacity-100 sm:h-36', alt: 'Pro parkrun', loading: 'lazy' %>
      <% end %>
      <% if top_level_domain == :ru %>
        <%= external_link_to 'https://rununion.ru/clubs/6' do %>
          <%= image_tag '/images/partners/run_union.png', class: 'h-24 opacity-90 transition-transform hover:-translate-y-1 hover:opacity-100 sm:h-36', alt: 'Союз любителей бега', loading: 'lazy' %>
        <% end %>
      <% end %>
      <% if top_level_domain == :rs %>
        <%= external_link_to 'https://www.instagram.com/grnhs_serbia/' do %>
          <%= image_tag '/images/partners/grnhs_serbia.svg', class: 'h-24 opacity-90 transition-transform hover:-translate-y-1 hover:opacity-100 sm:h-36', alt: 'Green House', loading: 'lazy' %>
        <% end %>
      <% end %>
    </div>
  </div>
</section>
