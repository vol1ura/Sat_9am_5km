<%
  team_members = [
    { key: :silaev, athlete_id: 5249 },
    { key: :shiryaev, athlete_id: 248 },
    { key: :letunovsky, athlete_id: 551 },
    { key: :hohlova, athlete_id: 4104 },
    { key: :yakovlev, athlete_id: 3293 },
    { key: :volodin, athlete_id: 1 },
    { key: :bashkina, athlete_id: 4029 },
  ]
  info_email = ENV.fetch('INFO_EMAIL')
%>
<% head_info :description, t('.description') %>

<%=
  render Ui::PageHeaderComponent.new(
    title: head_info(:title, t('navbars.about_s95.team')),
    description: t('.intro_html', events_link: events_path),
    variant: :rule,
  )
%>

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <% team_members.each do |member| %>
    <% name = t ".members.#{member[:key]}.name" %>
    <%= render Ui::CardComponent.new(hover: true, padding: false, class: 'h-full overflow-hidden') do %>
      <div class="aspect-square overflow-hidden bg-surface-elevated">
        <%=
          image_tag(
            "/images/team/#{member[:key]}.jpeg",
            class: 'h-full w-full object-cover object-top',
            alt: name,
            loading: 'lazy',
          )
        %>
      </div>
      <div class="p-4 text-center">
        <h2 class="font-display text-lg font-semibold text-ink">
          <%= link_to name, athlete_path(member[:athlete_id]), class: 'stretched-link text-ink no-underline hover:text-link' %>
        </h2>
        <p class="mb-0 mt-1 text-sm leading-relaxed text-ink-muted"><%= t ".members.#{member[:key]}.role" %></p>
      </div>
    <% end %>
  <% end %>
</div>

<div class="mt-10 rounded-xl border border-line bg-surface-elevated p-6 text-center sm:p-8">
  <p class="mb-0 text-base leading-relaxed text-ink/90">
    <%= t '.join_html', email: info_email, support_link: page_path(page: 'donation') %>
  </p>
</div>
