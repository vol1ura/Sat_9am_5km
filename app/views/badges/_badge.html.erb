<%= render Ui::CardComponent.new(hover: true, class: 'relative h-full') do %>
  <div class="flex items-start gap-3">
    <div class="flex size-16 shrink-0 items-center justify-center rounded-lg bg-surface-elevated p-1.5 sm:size-[4.5rem]">
      <%= image_tag badge.image.variant(:thumb), class: 'badge-thumb', alt: '', loading: 'lazy', aria: { hidden: true } %>
    </div>
    <div class="min-w-0 flex-1">
      <h3 class="font-display text-sm font-semibold leading-snug text-ink sm:text-base"><%= badge.name %></h3>
      <div class="mt-1 line-clamp-3 text-sm text-ink-muted"><%= sanitized_text badge.conditions %></div>
      <% if badge.received_date %>
        <p class="mt-2 text-xs text-ink-muted"><%= t '.event_date', date: l(badge.received_date, format: :long) %></p>
      <% end %>
    </div>
  </div>
  <%= link_to '', badge, class: 'absolute inset-0 rounded-lg', aria: { label: badge.name } %>
<% end %>
