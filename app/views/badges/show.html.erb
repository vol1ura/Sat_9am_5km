<% head_info :og_image, url_for(@badge.image) %>
<% info_suffix = " - ##{params[:page].to_i}" if params[:page].to_i.positive? %>
<% head_info :title, "#{@badge.name}#{info_suffix}" %>
<% head_info :description, "#{strip_tags(@badge.conditions)}#{info_suffix}".squish %>

<%= render 'shared/breadcrumbs', items: [
      { name: t('.main_page'), path: root_path },
      { name: t('navbars.top.badges'), path: badge_hub_path(@badge) },
      { name: @badge.name, current: true },
    ] %>

<%= render Ui::CardComponent.new(class: 'mb-8') do %>
  <div class="flex flex-col items-center gap-5 sm:flex-row sm:items-start">
    <div class="flex size-28 shrink-0 items-center justify-center rounded-xl bg-surface-elevated p-3 sm:size-32">
      <%= image_tag @badge.image.variant(:web), class: 'badge-show-thumb', alt: @badge.name %>
    </div>
    <div class="min-w-0 flex-1 text-center sm:text-left">
      <h1 class="mt-1 font-display text-2xl text-ink sm:text-3xl"><%= @badge.name %></h1>
      <div class="mt-3 max-w-none text-left text-sm leading-relaxed text-ink-muted [&_p+p]:mt-2"><%= sanitized_text @badge.conditions %></div>
      <% if @badge.funrun_kind? && @badge.received_date %>
        <p class="mt-3 text-sm text-ink-muted"><%= t '.event_date', date: l(@badge.received_date, format: :long) %></p>
      <% end %>
    </div>
  </div>
<% end %>

<section aria-labelledby="badge-holders-heading">
  <%= render Ui::SectionHeaderComponent.new(title: t('.holders'), id: 'badge-holders-heading') do |header| %>
    <% if @trophies.total_count.positive? %>
      <% header.with_actions do %>
        <span class="text-sm text-ink-muted"><%= t '.holders_count', count: @trophies.total_count %></span>
      <% end %>
    <% end %>
  <% end %>

  <% if @trophies.exists? %>
    <div class="data-table-shell">
      <table class="data-table data-table--compact">
        <thead>
          <tr>
            <th><%= t '.athlete' %></th>
            <% if @badge.record_kind? %>
              <th><%= t '.event' %></th>
              <th><%= t '.result' %></th>
              <th class="hidden-on-phone"><%= t '.date' %></th>
            <% elsif !@badge.funrun_kind? %>
              <th><%= t '.received_date' %></th>
            <% end %>
            <%= tag.th class: ('hidden-on-phone' unless @badge.funrun_kind?) do %>
              <%= t '.club' %>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <%= render partial: 'trophy', collection: @trophies %>
        </tbody>
      </table>
    </div>
    <div class="mt-4">
      <%= paginate @trophies, window: 2 %>
    </div>
  <% elsif @badge.funrun_kind? %>
    <%= render Ui::EmptyComponent.new(title: t('.soon')) %>
  <% else %>
    <%= render Ui::EmptyComponent.new(title: t('.nobody_has')) %>
  <% end %>
</section>
