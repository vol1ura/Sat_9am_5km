<%= render Ui::ModalComponent.new(id: 'barcodeModal', size: :md) do |modal| %>
  <% modal.with_title { "A#{code}" } %>
  <div class="flex justify-center">
    <%= barcode %>
  </div>
  <div class="mt-4 flex justify-end">
    <%= render Ui::ButtonComponent.new(variant: :secondary, type: 'button', data: { action: 'dialog#close' }, label: t('.close')) %>
  </div>
<% end %>
