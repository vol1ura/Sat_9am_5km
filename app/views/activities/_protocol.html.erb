<div class="data-table-shell">
  <table class="data-table sm:table-fixed">
    <thead>
      <tr>
        <th class="cell-center text-ink-muted w-10 px-1 whitespace-nowrap sm:w-20 sm:px-3">
          <span class="block sm:hidden"><%= t '.position_short' %></span>
          <span class="hidden sm:block"><%= t '.position_full' %></span>
        </th>
        <th><%= t '.athlete' %></th>
        <th class="cell-num-strong"><%= t '.time' %></th>
        <th class="cell-num"><%= t '.pace' %></th>
        <th class="hidden-on-phone"><%= t '.club' %></th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: 'result', collection: results %>
    </tbody>
  </table>
</div>
