<div class="mt-3" aria-hidden="true">
  <div class="grid grid-cols-1 gap-3 md:grid-cols-3">
    <% 3.times do %>
      <%= render Ui::CardComponent.new do %>
        <p class="mb-3 text-center">
          <span class="inline-block h-4 w-2/5 animate-pulse rounded bg-line"></span>
        </p>
        <span class="block h-[180px] animate-pulse rounded bg-line"></span>
        <p class="mb-0 mt-3 text-center">
          <span class="inline-block h-4 w-1/3 animate-pulse rounded bg-line"></span>
        </p>
      <% end %>
    <% end %>
  </div>
  <span class="sr-only"><%= t 'loading' %></span>
</div>
