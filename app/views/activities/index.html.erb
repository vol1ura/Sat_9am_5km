<% head_info :description, t('.description') %>

<%=
  render Ui::PageHeaderComponent.new(
    title: head_info(:title, t('navbars.top.recent_results')),
    description: t('.description'),
    variant: :rule,
  )
%>

<div class="data-table-shell">
  <table id="activities" class="data-table">
    <thead>
      <tr data-controller="table-head">
        <th><%= t '.date' %></th>
        <th class="sortable" data-action="click->table-head#toggleSort">
          <span><%= t '.event' %></span>
          <span class="sort-arrow" aria-hidden="true"><i class="fa"></i></span>
        </th>
        <th class="sortable" data-action="click->table-head#toggleSort">
          <span><%= t '.town' %></span>
          <span class="sort-arrow" aria-hidden="true"><i class="fa"></i></span>
        </th>
        <th class="sortable cell-center" data-action="click->table-head#toggleSort">
          <span><%= t '.athletes' %></span>
          <span class="sort-arrow" aria-hidden="true"><i class="fa"></i></span>
        </th>
        <th class="sortable cell-center" data-action="click->table-head#toggleSort">
          <span><%= t '.volunteers' %></span>
          <span class="sort-arrow" aria-hidden="true"><i class="fa"></i></span>
        </th>
        <th><%= t '.first_man' %></th>
        <th class="sortable" data-action="click->table-head#toggleSort">
          <span><i class="fa-solid fa-clock"></i></span>
          <span class="sort-arrow" aria-hidden="true"><i class="fa"></i></span>
        </th>
        <th><%= t '.first_woman' %></th>
        <th class="sortable" data-action="click->table-head#toggleSort">
          <span><i class="fa-solid fa-clock"></i></span>
          <span class="sort-arrow" aria-hidden="true"><i class="fa"></i></span>
        </th>
      </tr>
    </thead>
    <tbody>
      <%= render @activities, cached: ->(activity) { locale_cache_key(activity) } %>
    </tbody>
  </table>
</div>

<section class="mt-8">
  <%= render Ui::SectionHeaderComponent.new title: t('.dashboard') %>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
    <%= render 'dashboard_card', chart: :participants %>
    <%= render 'dashboard_card', chart: :gender %>
    <%= render 'dashboard_card', chart: :volunteers %>
  </div>
</section>
