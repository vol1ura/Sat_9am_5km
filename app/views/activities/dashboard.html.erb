<%= turbo_frame_tag "dashboard_#{@dashboard_chart.key}" do %>
  <% if @dashboard_chart.empty? %>
    <p class="flex min-h-[220px] items-center justify-center text-center text-sm text-ink-muted">
      <%= t '.no_data' %>
    </p>
  <% else %>
    <%= tag.div class: 'min-h-[240px]',
          data: {
            controller: 'pie-chart',
            pie_chart_series_value: @dashboard_chart.series,
            pie_chart_labels_value: @dashboard_chart.labels,
            pie_chart_chart_id_value: @dashboard_chart.id,
            pie_chart_unit_value: t('.people'),
            pie_chart_total_label_value: t('.total'),
            pie_chart_error_value: t('.error'),
          } %>
  <% end %>
<% end %>
