<% athlete_name = @athlete&.name || t('common.nobody') %>
<% head_info :title, t('.title', athlete_name:) %>
<% head_info :description, t('.description', athlete_name:) %>

<%= render 'ratings/hub_tabs' %>

<div>
  <h1 class="mt-2"><%= t '.header' %></h1>
  <p><%= t '.subheader' %></p>
</div>

<% if @duels_data.any? %>
  <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
    <% @duels_data.each do |friend, data| %>
      <%= render Ui::CardComponent.new(class: 'shadow-sm') do |card| %>
        <% card.with_header do %>
          <div class="flex items-center justify-between gap-2 border-b border-line px-4 py-3">
            <div class="flex items-center gap-2">
              <%= image_tag user_image_path(friend.user), class: 'avatar-50' %>
              <div>
                <h5 class="mb-0 font-semibold">
                  <%= link_to friend.name, athlete_path(friend), class: 'text-ink no-underline hover:text-brand' %>
                </h5>
                <small class="text-ink-muted">
                  <%= t '.duels_count', count: data[:stats][:total_duels] %>
                </small>
              </div>
            </div>
            <div class="ms-1 text-end">
              <%= render Ui::ButtonComponent.new(variant: :secondary, size: :sm, href: duel_path(friend), class: 'text-nowrap', label: t('.view_all')) %>
            </div>
          </div>
        <% end %>

        <div class="mb-3 grid grid-cols-2 gap-2">
          <div class="text-center">
            <div class="text-2xl font-semibold text-success"><%= data[:stats][:user_wins] %></div>
            <small class="text-ink-muted"><%= t '.my_wins' %></small>
          </div>
          <div class="text-center">
            <div class="text-2xl font-semibold text-danger"><%= data[:stats][:friend_wins] %></div>
            <small class="text-ink-muted"><%= t '.friend_wins' %></small>
          </div>
        </div>

        <div class="mb-2 h-2 overflow-hidden rounded-full bg-surface-elevated">
          <% win_rate = data[:stats][:user_win_rate] %>
          <div class="h-full bg-success" style="width: <%= win_rate %>%"></div>
        </div>
        <div class="flex justify-between">
          <small class="text-ink-muted"><%= t '.win_rate' %>: <%= win_rate %>%</small>
          <%= render 'friend_stats', stats: data[:stats] %>
        </div>

        <div class="mt-3">
          <h6 class="mb-2 text-ink-muted"><%= t '.recent_duels' %></h6>
          <% data[:duels].first(3).each do |duel| %>
            <%= render 'duel_compact', duel: %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="py-5 text-center">
    <i class="fa-solid fa-crossed-swords text-6xl text-ink-muted"></i>
    <h3 class="mt-3 text-ink-muted"><%= t '.no_duels' %></h3>
    <p class="text-ink-muted"><%= t '.no_duels_description' %></p>
    <%= render Ui::ButtonComponent.new(variant: :primary, href: athlete_path(@athlete), label: t('.profile')) %>
  </div>
<% end %>
