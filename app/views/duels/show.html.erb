<%
  athlete_name = @athlete.name || t('common.nobody')
  friend_name = @friend.name || t('common.nobody')
%>
<% head_info :title, t('.title', athlete_name:, friend_name:) %>
<% head_info :description, t('.description', athlete_name:, friend_name:) %>

<div>
  <nav aria-label="breadcrumb" class="mb-4 text-sm text-ink-muted">
    <ol class="flex flex-wrap items-center gap-1">
      <li><%= link_to t('.duels'), duels_path, class: 'text-brand hover:text-accent' %></li>
      <li class="before:px-1 before:content-['/'] text-ink" aria-current="page"><%= friend_name %></li>
    </ol>
  </nav>

  <div class="mb-4 flex items-center justify-between">
    <h1 class="mb-0">
      <i class="fa-solid fa-people-arrows me-2"></i>
      <%= t '.header', friend_name: %>
    </h1>
  </div>
</div>

<% if @friend_duels %>
  <div class="mb-4">
    <%= render Ui::CardComponent.new do %>
      <div class="grid grid-cols-3 gap-4 text-center md:grid-cols-4">
        <div>
          <div class="text-2xl font-semibold text-brand"><%= @friend_duels[:stats][:total_duels] %></div>
          <small class="text-ink-muted"><%= t('.total_duels') %></small>
        </div>
        <div>
          <div class="text-2xl font-semibold text-success"><%= @friend_duels[:stats][:user_wins] %></div>
          <small class="text-ink-muted"><%= t('.my_wins') %></small>
        </div>
        <div>
          <div class="text-2xl font-semibold text-danger"><%= @friend_duels[:stats][:friend_wins] %></div>
          <small class="text-ink-muted"><%= t('.friend_wins') %></small>
        </div>
        <div class="col-span-3 mt-2 md:col-span-1 md:mt-0">
          <div class="text-2xl font-semibold text-brand">
            <%= @friend_duels[:stats][:user_win_rate] %>%
          </div>
          <small class="text-ink-muted"><%= t('.win_rate') %></small>
          <div class="mt-2 h-2 overflow-hidden rounded-full bg-surface-elevated">
            <div class="h-full bg-success" style="width: <%= @friend_duels[:stats][:user_win_rate] %>%"></div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mb-4 grid grid-cols-1 gap-4 md:grid-cols-2">
    <%= render Ui::CardComponent.new(class: 'h-full') do %>
      <div class="text-center">
        <%= image_tag user_image_path(@athlete&.user), class: 'avatar-100 mb-3 mx-auto' if @athlete&.user %>
        <h5><%= @athlete&.name || t('common.nobody') %></h5>
        <div class="mt-2">
          <%= render 'friend_stats', stats: @friend_duels[:stats] %>
        </div>
      </div>
    <% end %>

    <%= render Ui::CardComponent.new(class: 'h-full') do %>
      <div class="text-center">
        <%= image_tag user_image_path(@friend.user), class: 'avatar-100 mb-3 mx-auto' %>
        <h5>
          <%= link_to @friend.name, athlete_path(@friend), class: 'text-ink no-underline hover:text-brand' %>
        </h5>
        <p class="mb-0 text-ink-muted"><%= t '.your_friend' %></p>
      </div>
    <% end %>
  </div>

  <div>
    <h2 class="mb-3">
      <i class="fa-solid fa-history me-2"></i>
      <%= t('.duel_history') %>
    </h2>

    <% @friend_duels[:duels].each do |duel| %>
      <%= render 'duel', duel: %>
    <% end %>
  </div>
<% else %>
  <div class="py-5 text-center">
    <i class="fa-solid fa-crossed-swords text-6xl text-ink-muted"></i>
    <h2 class="mt-3 text-ink-muted"><%= t('.no_duels') %></h2>
    <p class="text-ink-muted">
      <%= t '.no_duels_with_friend', friend_name: %>
    </p>
    <%= render Ui::ButtonComponent.new(variant: :primary, href: duels_path, label: t('.back_to_all')) %>
  </div>
<% end %>
