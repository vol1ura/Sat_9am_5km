<% head_info :title, t('.title') %>
<% head_info :description, t('.description') %>

<%= render 'ratings/hub_tabs' %>

<div>
  <h1 class="mt-2"><%= t '.header' %></h1>
  <p class="text-xl font-semibold text-ink-muted mb-1"><%= l @target_date, format: :long %></p>
  <p><%= t '.description' %></p>
</div>

<% unless @has_friends %>
  <div class="py-5 text-center">
    <i class="fa-solid fa-people-arrows text-6xl text-ink-muted"></i>
    <h4 class="mt-3 text-ink-muted"><%= t '.no_friends' %></h4>
    <p class="text-ink-muted"><%= t '.no_friends_description' %></p>
    <%= render Ui::ButtonComponent.new(variant: :primary, href: athlete_path(@athlete), label: t('.profile')) %>
  </div>
  <% return %>
<% end %>

<% if @target_date != Date.current && @results.blank? %>
  <div class="my-3 rounded-lg border border-info/20 bg-info-subtle px-4 py-3 text-info" role="alert">
    <%= t '.not_published_yet' %>
  </div>
<% end %>

<% if @target_date != Date.current && @results.find { |r| r.athlete_id == @athlete.id }.nil? && @volunteers.find { |v| v.athlete_id == @athlete.id }.nil? %>
  <div class="my-3 rounded-lg border border-warning/20 bg-warning-subtle px-4 py-3 text-warning" role="alert">
    <%= t '.you_did_not_participate' %>
  </div>
<% end %>

<% if @results.present? %>
  <div class="data-table-shell mb-4">
    <table class="data-table">
      <thead>
        <tr>
          <th scope="col" class="cell-num-muted">#</th>
          <th scope="col"></th>
          <th scope="col"><%= t '.athlete' %></th>
          <th scope="col" class="cell-num-strong"><%= t '.result' %></th>
          <th scope="col" class="cell-center"><%= t '.pace' %></th>
          <th scope="col"><%= t '.event' %></th>
          <th scope="col"><%= t '.club' %></th>
        </tr>
      </thead>
      <tbody>
        <% @results.each_with_index do |res, idx| %>
          <%= tag.tr class: (res.athlete_id == @athlete.id ? 'bg-success-subtle' : nil) do %>
            <td class="cell-num-muted"><%= idx + 1 %></td>
            <td>
              <%= image_tag user_image_path(res.athlete&.user), class: 'avatar-50' %>
            </td>
            <td>
              <%= link_to res.athlete.name, res.athlete, class: 'athlete-link font-semibold' %>
            </td>
            <td class="cell-num-strong">
              <% if res.personal_best %>
                <%= tag.i class: 'fa-solid fa-bolt text-brand', title: t('activities.result.personal_best') %>
              <% end %>
              <%= res.time_string %>
            </td>
            <td class="cell-center">
              <%= human_result_pace res.total_time %>
            </td>
            <td><%= link_to res.activity.event.name, res.activity %></td>
            <td>
              <% club = res.athlete&.club %>
              <%= link_to club.name, club_path(club.slug) if club %>
            </td>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<% if @volunteers_by_role.present? %>
  <%= render Ui::CardComponent.new do |card| %>
    <% card.with_header do %>
      <h4 class="mb-0 font-semibold"><%= t '.volunteers_title' %></h4>
    <% end %>
    <% Volunteer.roles.each_key do |role| %>
      <% volunteers = @volunteers_by_role[role] %>
      <% next if volunteers.blank? %>
      <div class="mb-2">
        <strong><%= human_volunteer_role(role) %>:</strong>
        <% volunteers.each do |volunteer| %>
          <%= link_to volunteer.athlete.name, volunteer.athlete %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
