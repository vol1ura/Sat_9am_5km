<div class="flex items-center justify-between border-b border-line border-light py-1">
  <div class="text-sm">
    <strong><%= l duel[:date] %></strong>
    <span class="text-ink-muted">
      <%= link_to duel[:event].name, event_path(duel[:event].code_name), class: 'text-ink-muted no-underline hover:text-brand' %>
    </span>
  </div>

  <div class="flex items-center gap-2">
    <% if duel[:winner] == :user %>
      <%= render Ui::BadgeComponent.new(variant: :success) do %>
        <i class="fa-solid fa-trophy me-1"></i>
        <%= t '.you_won' %>
      <% end %>
    <% else %>
      <%= render Ui::BadgeComponent.new(variant: :danger) do %>
        <i class="fa-solid fa-flag me-1"></i>
        <%= t '.friend_won' %>
      <% end %>
    <% end %>

    <% if duel[:time_difference] %>
      <small class="text-ink-muted">
        <%= Result.time_string duel[:time_difference] %>
      </small>
    <% end %>
  </div>
</div>
