<% win_rate = stats[:user_win_rate] %>
<% if win_rate > 60 %>
  <%= render Ui::BadgeComponent.new(variant: :success) do %>
    <i class="fa-solid fa-crown me-1"></i>
    <%= t('.dominating') %>
  <% end %>
<% elsif win_rate > 40 %>
  <%= render Ui::BadgeComponent.new(variant: :default) do %>
    <i class="fa-solid fa-handshake me-1"></i>
    <%= t('.competitive') %>
  <% end %>
<% else %>
  <%= render Ui::BadgeComponent.new(variant: :danger) do %>
    <i class="fa-solid fa-flag me-1"></i>
    <%= t('.struggling') %>
  <% end %>
<% end %>
