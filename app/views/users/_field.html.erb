<%= turbo_frame_tag field do %>
  <div class="flex items-center">
    <span class="me-auto"><%= current_user.public_send(field) %></span>
    <%= render Ui::ButtonComponent.new(variant: :secondary, size: :sm, href: edit_user_path(field:), title: 'Изменить') do %>
      <i class="fa-solid fa-pen-to-square text-brand"></i>
    <% end %>
  </div>
<% end %>
