<% head_info :description, t('.description', user_name: current_user.full_name) %>
<div class="row justify-content-center">
  <div style="max-width: 400px;">
    <h1 class="mb-4"><%= head_info :title, t('.title') %></h1>
    <%= turbo_frame_tag current_user do %>
      <div class="card border-0 mb-4">
        <div class="card-body p-2">
          <div class="d-flex align-items-center">
            <div class="flex-grow-1 me-3">
              <div class="d-flex flex-column">
                <p class="fs-3 mb-1"><%= current_user.first_name %></p>
                <p class="fs-3 mb-0"><%= current_user.last_name %></p>
              </div>
            </div>
            <div class="flex-shrink-0">
              <%= image_tag user_image_path(current_user), class: 'avatar-100' %>
            </div>
          </div>

          <div class="d-flex flex-column mt-3">
            <p class="mb-2">
              <i class="fa-solid fa-qrcode text-primary me-3"></i>
              <%= link_to "A#{current_user.athlete.code}", '#', data: { 'bs-toggle' => 'modal', 'bs-target' => '#barcodeModal' } %>
            </p>
            <p class="mb-2">
              <i class="fa-solid fa-envelope text-primary me-3"></i>
              <% if current_user.email %>
                <%= current_user.email %>
              <% else %>
                <span class="text-body-secondary"><%= t '.not_specified' %></span>
              <% end %>
              <% if current_user.unconfirmed_email %>
                <br>
                <small class="text-warning-emphasis">
                  <i class="fa-solid fa-clock me-1"></i>
                  <%= t '.email_pending_badge', email: current_user.unconfirmed_email %>
                </small>
              <% end %>
            </p>
            <p class="mb-2">
              <i class="fa-solid fa-phone text-primary me-3"></i>
              <%= current_user.phone ? human_phone(current_user.phone) : t('.not_specified') %>
            </p>
            <p class="mb-2">
              <i class="fa-solid fa-people-group text-primary me-3"></i>
              <%= current_user&.athlete&.club&.name || t('.not_specified') %>
            </p>
            <p class="mb-2">
              <i class="fa-solid fa-house text-primary me-3"></i>
              <%= current_user&.athlete&.event&.name || t('.not_specified') %>
            </p>
            <div class="mt-3">
              <h5 class="mb-3"><%= t '.emergency_contact' %></h5>
              <p class="mb-2">
                <i class="fa-solid fa-phone text-primary me-3"></i>
                <% if current_user.emergency_contact_phone %>
                  <%= human_phone current_user.emergency_contact_phone %>
                  (<%= current_user.emergency_contact_name %>)
                <% else %>
                  <%= t '.not_specified' %>
                <% end %>
              </p>
            </div>
          </div>
        </div>
        <div class="card-body mt-3 p-2">
          <%= link_to edit_user_path, class: 'btn btn-outline-primary', title: t('.edit') do %>
            <i class="fa-solid fa-pen-to-square me-2"></i><%= t '.edit' %>
          <% end %>
        </div>
        <div class="card-body border-top mt-5 p-2">
          <h5 class="mb-3 text-danger"><%= t '.delete_account.title' %></h5>
          <p class="mb-3 text-body-secondary"><%= t '.delete_account.lead' %></p>
          <button
            type="button"
            class="btn btn-outline-danger"
            data-bs-toggle="modal"
            data-bs-target="#deleteAccountModal"
          >
            <%= t '.delete_account.button' %>
          </button>
        </div>
      </div>

      <div
        class="modal fade"
        id="deleteAccountModal"
        data-bs-backdrop="static"
        data-bs-keyboard="false"
        tabindex="-1"
        aria-labelledby="deleteAccountModalLabel"
        aria-hidden="true"
        data-controller="account-deletion"
      >
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <%= form_with url: user_path, method: :delete, data: { turbo: false } do %>
              <div class="modal-header">
                <h5 class="modal-title" id="deleteAccountModalLabel"><%= t '.delete_account.modal_title' %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t 'users.edit.cancel' %>"></button>
              </div>
              <div class="modal-body">
                <p class="mb-0"><%= t '.delete_account.modal_text' %></p>
                <div class="form-check mt-3">
                  <%=
                    check_box_tag(
                      :confirm_deletion,
                      '1',
                      false,
                      class: 'form-check-input',
                      id: 'confirm_deletion',
                      data: {
                        account_deletion_target: 'checkbox',
                        action: 'account-deletion#toggleSubmit',
                      },
                    )
                  %>
                  <%= label_tag :confirm_deletion, t('.delete_account.confirm_label'), class: 'form-check-label' %>
                </div>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal"><%= t 'users.edit.cancel' %></button>
                <%=
                  submit_tag(
                    t('.delete_account.submit'),
                    class: 'btn btn-danger',
                    disabled: true,
                    data: { account_deletion_target: 'submit' },
                  )
                %>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <%= render 'shared/barcode_modal', code: current_user.athlete.code, barcode: @barcode %>
    <% end %>
  </div>
</div>
