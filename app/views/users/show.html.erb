<% head_info :description, t('.description', user_name: current_user.full_name) %>

<div class="page-container page-container--narrow">
  <%= render Ui::PageHeaderComponent.new(title: head_info(:title, t('.title'))) %>

  <%= turbo_frame_tag current_user do %>
    <%= render Ui::CardComponent.new(class: 'mb-4') do %>
      <div class="flex flex-col items-center border-b border-line pb-5 text-center">
        <%= image_tag user_image_path(current_user), class: 'avatar-100', alt: current_user.full_name %>
        <p class="mt-4 font-display text-2xl font-bold leading-tight text-ink">
          <%= current_user.first_name %>
        </p>
        <p class="font-display text-2xl font-bold leading-tight text-ink">
          <%= current_user.last_name %>
        </p>
      </div>

      <div class="mt-5 space-y-4">
        <div class="flex items-start gap-3 text-sm">
          <i class="fa-solid fa-qrcode mt-0.5 w-4 shrink-0 text-brand" aria-hidden="true"></i>
          <div>
            <%= link_to "A#{current_user.athlete.code}", '#',
                  class: 'font-medium text-brand hover:text-accent',
                  data: { controller: 'dialog', dialog_id_value: 'barcodeModal', action: 'click->dialog#open' } %>
          </div>
        </div>

        <div class="flex items-start gap-3 text-sm">
          <i class="fa-solid fa-envelope mt-0.5 w-4 shrink-0 text-brand" aria-hidden="true"></i>
          <div class="min-w-0">
            <% if current_user.email %>
              <span class="break-all"><%= current_user.email %></span>
            <% else %>
              <span class="text-ink-muted"><%= t '.not_specified' %></span>
            <% end %>
            <% if current_user.unconfirmed_email %>
              <p class="mt-1 text-warning">
                <i class="fa-solid fa-clock me-1" aria-hidden="true"></i>
                <%= t '.email_pending_badge', email: current_user.unconfirmed_email %>
              </p>
            <% end %>
          </div>
        </div>

        <div class="flex items-start gap-3 text-sm">
          <i class="fa-solid fa-phone mt-0.5 w-4 shrink-0 text-brand" aria-hidden="true"></i>
          <div>
            <%= current_user.phone ? human_phone(current_user.phone) : content_tag(:span, t('.not_specified'), class: 'text-ink-muted') %>
          </div>
        </div>

        <div class="flex items-start gap-3 text-sm">
          <i class="fa-solid fa-people-group mt-0.5 w-4 shrink-0 text-brand" aria-hidden="true"></i>
          <div><%= current_user&.athlete&.club&.name || content_tag(:span, t('.not_specified'), class: 'text-ink-muted') %></div>
        </div>

        <div class="flex items-start gap-3 text-sm">
          <i class="fa-solid fa-house mt-0.5 w-4 shrink-0 text-brand" aria-hidden="true"></i>
          <div><%= current_user&.athlete&.event&.name || content_tag(:span, t('.not_specified'), class: 'text-ink-muted') %></div>
        </div>

        <div class="rounded-lg border border-line bg-surface-elevated/60 p-4">
          <h2 class="mb-3 text-sm font-semibold text-ink"><%= t '.emergency_contact' %></h2>
          <div class="flex items-start gap-3 text-sm">
            <i class="fa-solid fa-phone mt-0.5 w-4 shrink-0 text-brand" aria-hidden="true"></i>
            <div>
              <% if current_user.emergency_contact_phone %>
                <%= human_phone current_user.emergency_contact_phone %>
                <span class="text-ink-muted">(<%= current_user.emergency_contact_name %>)</span>
              <% else %>
                <span class="text-ink-muted"><%= t '.not_specified' %></span>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-6 pt-4 flex flex-col sm:flex-row sm:justify-start border-t border-line">
        <%= render Ui::ButtonComponent.new(variant: :secondary, href: edit_user_path) do %>
          <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
          <%= t '.edit' %>
        <% end %>
      </div>
    <% end %>

    <%= render Ui::CardComponent.new(class: 'border-danger/25 bg-danger-subtle/30') do %>
      <h2 class="mb-2 font-display text-base font-semibold text-danger"><%= t '.delete_account.title' %></h2>
      <p class="mb-4 text-sm leading-relaxed text-ink-muted"><%= t '.delete_account.lead' %></p>
      <div class="flex flex-col sm:flex-row sm:justify-start">
        <%= render Ui::ButtonComponent.new(
            variant: :danger,
            type: 'button',
            label: t('.delete_account.button'),
            data: { controller: 'dialog', dialog_id_value: 'deleteAccountModal', action: 'click->dialog#open' },
          ) %>
      </div>
    <% end %>

    <%= render Ui::ModalComponent.new(id: 'deleteAccountModal', size: :md) do |modal| %>
      <% modal.with_title { t('.delete_account.modal_title') } %>
      <%= form_with url: user_path, method: :delete, data: { turbo: false, controller: 'account-deletion' } do %>
        <p class="text-sm leading-relaxed text-ink-muted"><%= t '.delete_account.modal_text' %></p>
        <label class="<%= form_toggle_label_class %> mt-4 rounded-lg border border-line bg-surface-elevated p-3" for="confirm_deletion">
          <%=
            check_box_tag(
              :confirm_deletion,
              '1',
              false,
              class: form_toggle_input_class,
              id: 'confirm_deletion',
              data: {
                account_deletion_target: 'checkbox',
                action: 'change->account-deletion#toggleSubmit',
              },
            )
          %>
          <span class="form-toggle__switch" aria-hidden="true"></span>
          <span class="form-toggle__label"><%= t('.delete_account.confirm_label') %></span>
        </label>
        <div class="mt-5 flex flex-col-reverse gap-2 sm:flex-row sm:justify-start">
          <%= render Ui::ButtonComponent.new(variant: :secondary, type: 'button', label: t('users.edit.cancel'), data: { action: 'dialog#close' }) %>
          <%=
            render Ui::ButtonComponent.new(
              variant: :danger,
              type: 'submit',
              label: t('.delete_account.submit'),
              disabled: true,
              data: { account_deletion_target: 'submit' },
            )
          %>
        </div>
      <% end %>
    <% end %>

    <%= render 'shared/barcode_modal', code: current_user.athlete.code, barcode: @barcode %>
  <% end %>
</div>
