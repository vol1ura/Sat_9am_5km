<div class="flex justify-center mt-2">
  <%=
    render(Ui::ButtonComponent.new(
      variant: :secondary,
      type: 'button',
      data: {
        controller: 'collapse',
        action: 'click->collapse#toggle',
        collapse_show_value: t('button.show_more'),
        collapse_hide_value: t('button.show_less'),
      },
      aria: { expanded: 'false' },
    ))
  %>
</div>
