<%= turbo_frame_tag 'live_results_frame' do %>
  <%= render Ui::CardComponent.new(class: 'h-full border-brand/25 shadow-sm') do |card| %>
    <% card.with_header do %>
      <section class="text-lg font-semibold">
        <i class="fa-solid fa-stopwatch text-brand"></i>
        <% if live_results.key?('start_time') %>
          <span class="ms-2 font-mono text-brand"
                data-controller="live-timer"
                data-live-timer-start-time-value="<%= live_results['start_time'] %>"
                data-live-timer-target="time">
            --:--:--
          </span>
        <% else %>
          <span class="ms-2 font-mono text-brand">--:--:--</span>
        <% end %>
      </section>
    <% end %>

    <% if live_results.key?('results') %>
      <div class="data-table-inset">
      <table class="data-table data-table--compact">
        <thead>
          <tr>
            <th scope="col" class="cell-num-muted"><%= t('.position') %></th>
            <th scope="col" class="cell-num-strong"><%= t('.time') %></th>
            <th scope="col" class="cell-num text-ink-muted"><%= t('.gap') %></th>
          </tr>
        </thead>
        <tbody id="live-results">
          <%= render 'events/live_results', results: live_results['results'] %>
        </tbody>
      </table>
      </div>
    <% else %>
      <div class="py-4 text-center">
        <i class="fa-solid fa-stopwatch mb-3 text-4xl text-ink-muted"></i>
        <h5><%= t('.waiting_for_results') %></h5>
        <p class="text-ink-muted"><%= t('.results_will_appear') %></p>
      </div>
    <% end %>
  <% end %>
<% end %>
