<% leader_time = results.first&.dig('total_time') %>

<% results.each_with_index do |result, index| %>
  <tr>
    <td class="cell-num-muted"><%= result['position'] %></td>
    <td class="cell-num-strong"><%= result['total_time'].sub(/\.\d{2}$/, '') %></td>
    <td class="cell-num text-ink-muted">
      <% unless index.zero? %>
        <div class="text-xs"><%= calculate_time_gap(result['total_time'], results[index - 1]['total_time']) %></div>
        <div class="text-xs">(1) <%= calculate_time_gap(result['total_time'], leader_time) %></div>
      <% end %>
    </td>
  </tr>
<% end %>
