<% head_info :title, t('.title', place: @event.place, town: @event.town) %>
<% head_info :description, strip_tags(@event.description).squish %>

<div class="relative -mx-4 -mt-6 mb-3 sm:mt-0 sm:mx-0">
  <div class="absolute inset-x-0 top-0 z-10 flex w-full items-start justify-between bg-gradient-to-b from-black/40 to-transparent px-3 py-2 sm:rounded-t-lg">
    <h1 class="text-lg font-display font-semibold text-white sm:text-xl"><%= @event.name %></h1>
    <%= render 'favorite_events/heart', event: @event %>
  </div>
  <%= event_main_image_tag @event, class: 'w-full rounded-none object-cover sm:rounded-lg', alt: t('.place'), title: @event.name %>
</div>

<% unless @event.active %>
  <div class="mb-3 flex items-start gap-3 rounded-lg border border-danger/20 bg-danger-subtle px-4 py-3 text-danger" role="alert">
    <i class="fa-solid fa-triangle-exclamation shrink-0 text-2xl"></i>
    <div>
      <strong><%= t '.attention' %></strong> <%= @total_activities.zero? ? t('.opening_soon') : t('.start_cancelled') %>
      <%= t '.inactivity_disclaimer_html', link: Rails.configuration.telegram[top_level_domain] %>
      <% if @event.cancellation_reason.present? %>
        <br><strong><%= t '.cancellation_reason' %></strong>
        <%= @event.cancellation_reason %>
      <% end %>
    </div>
  </div>
<% end %>

<div class="mb-3 grid grid-cols-1 gap-3 md:grid-cols-2">
  <%= render 'card', header: t('.description') do %>
    <div class="text-ink"><%= sanitized_text @event.description %></div>
  <% end %>
  <%= render 'card', header: t('.how_participate') do %>
    <p><%= t '.about_participation' %></p>
    <% if @event.active && user_signed_in? %>
      <div id="going_to_form">
        <%= render 'going_tos/form' %>
      </div>
    <% else %>
      <%= render Ui::ButtonComponent.new(variant: :danger, href: new_user_registration_path, label: t('.registration')) %>
    <% end %>
  <% end %>
  <%= render 'card', header: t('.volunteers') do %>
    <p class="mb-2"><%= t '.about_volunteers' %></p>
    <%= render Ui::ButtonComponent.new(variant: :secondary, href: volunteering_event_path(@event.code_name), label: t('.show')) %>
  <% end %>
  <%= render 'card', header: t('.our_contacts') do %>
    <p class="mb-2"><strong><%= t '.place' %>:</strong> <%= @event.place_description %></p>
    <div class="flex flex-wrap gap-2">
      <% @event.contacts.order(:contact_type).each do |contact| %>
        <% next if contact.contact_type == 'instagram' && top_level_domain == :ru %>
        <%
          link_referer =
            case contact.contact_type
            when 'email'
              "mailto:#{contact.link}"
            when 'phone'
              "tel:#{contact.link}"
            else
              contact.link.html_safe
            end
        %>
        <%= external_link_to(link_referer, class: 'mb-2', title: human_contact_type(contact.contact_type)) do %>
          <%= render "events/contacts/#{contact.contact_type}" %>
        <% end %>
      <% end %>
    </div>
  <% end %>
  <% if @almost_jubilee_by_results.present? %>
    <%= render 'card', header: t('.jubilee_by_results') do %>
      <div class="data-table-inset">
        <table class="data-table data-table--compact">
          <thead>
            <tr>
              <th scope="col"><%= t '.athlete' %></th>
              <th scope="col" class="cell-num-strong"><%= t '.results_count' %></th>
            </tr>
          </thead>
          <tbody>
            <% @almost_jubilee_by_results.each do |athlete| %>
              <tr>
                <td><%= link_to athlete.name, athlete_path(athlete), class: 'athlete-link font-semibold' %></td>
                <td class="cell-num-strong"><%= athlete.stats['results']['count'] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% end %>
  <% if @almost_jubilee_by_volunteers.present? %>
    <%= render 'card', header: t('.jubilee_by_volunteering') do %>
      <div class="data-table-inset">
        <table class="data-table data-table--compact">
          <thead>
            <tr>
              <th scope="col"><%= t '.athlete' %></th>
              <th scope="col" class="cell-num-strong"><%= t '.volunteering_count' %></th>
            </tr>
          </thead>
          <tbody>
            <% @almost_jubilee_by_volunteers.each do |athlete| %>
              <tr>
                <td><%= link_to athlete.name, athlete_path(athlete), class: 'athlete-link font-semibold' %></td>
                <td class="cell-num-strong"><%= athlete.stats['volunteers']['count'] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% end %>
</div>

<% if @event.route_map.attached? %>
  <%= render 'route_map', header: t('.route_map') %>
<% end %>

<h2><%= t '.results' %></h2>
<% if @total_activities.zero? %>
  <p><%= t '.no_results_disclaimer' %></p>
<% else %>
  <div class="data-table-shell">
    <table class="data-table">
      <thead>
        <tr>
          <th class="cell-num-muted">#</th>
          <th><%= t 'activities.index.date' %></th>
          <th class="cell-center"><span class="cropped-on-phone"><%= t 'activities.index.athletes' %></span></th>
          <th class="cell-center"><span class="cropped-on-phone"><%= t 'activities.index.volunteers' %></span></th>
          <th class="hidden-on-phone"><%= t 'activities.index.first_man' %></th>
          <th class="hidden-on-phone"><%= t 'activities.index.first_woman' %></th>
        </tr>
      </thead>
      <tbody>
        <% if @event.live_results %>
          <tr class="bg-info-subtle">
            <td class="cell-num-muted"><%= @total_activities.next %></td>
            <td><%= link_to l(Date.current), live_event_path(@event.code_name) %></td>
            <td colspan="2">
              <%= link_to live_event_path(@event.code_name), class: 'no-underline' do %>
                <%= render Ui::BadgeComponent.new(variant: :danger) do %>
                  <i class="fa-solid fa-circle" style="animation: blink 0.8s infinite;"></i>
                  <%= t '.live_streaming' %>
                <% end %>
              <% end %>
            </td>
            <td colspan="2" class="hidden-on-phone text-ink-muted">
              <small><%= t '.live_streaming_description' %></small>
            </td>
          </tr>
        <% end %>
        <%= render partial: 'activity', collection: @event.activities.published.order(date: :desc) %>
      </tbody>
    </table>
  </div>
  <%= render '/expand_button' if @total_activities > 15 %>

  <div class="mt-3 grid grid-cols-1 gap-3 md:grid-cols-2">
    <%= render 'card', header: t('.event_totals') do %>
      <ul class="divide-y divide-line">
        <li class="flex items-center gap-3 py-3">
          <%= render Ui::BadgeComponent.new(variant: :brand) { @total_activities } %>
          <%= t '.totals.activities' %>
        </li>
        <li class="flex items-center gap-3 py-3">
          <%= render Ui::BadgeComponent.new(variant: :brand) { @results_count.sum { |_, v| v } } %>
          <%= t '.totals.results' %>
        </li>
        <li class="flex items-center gap-3 py-3">
          <%= render Ui::BadgeComponent.new(variant: :brand) { @uniq_athletes_count } %>
          <%= t '.totals.athletes' %>
        </li>
        <li class="flex items-center gap-3 py-3">
          <%= render Ui::BadgeComponent.new(variant: :brand) { @volunteers_count.sum { |_, v| v } } %>
          <%= t '.totals.volunteering' %>
        </li>
        <li class="flex items-center gap-3 py-3">
          <%= render Ui::BadgeComponent.new(variant: :brand) { @uniq_volunteers_count } %>
          <%= t '.totals.uniq_volunteers' %>
        </li>
      </ul>
    <% end %>
    <%= render 'card', header: t('.event_dynamics') do %>
      <div class="grid grid-cols-2 gap-3" data-controller="event">
        <div data-event-target="results"></div>
        <div data-event-target="volunteers"></div>
      </div>
    <% end %>
  </div>
<% end %>
