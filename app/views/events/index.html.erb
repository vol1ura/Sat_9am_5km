<% head_info :title, t('.our_events') %>

<%= render Ui::PageHeaderComponent.new(title: t('.our_events')) do |header| %>
  <% header.with_actions do %>
    <%= render Ui::ButtonComponent.new(variant: :secondary, href: map_events_path, label: t('.map')) %>
  <% end %>
<% end %>

<%= render 'favorite_events_section' %>
<div class="grid grid-cols-1 gap-3 md:grid-cols-2">
  <%= render partial: 'event_card', collection: @events, as: :event %>
</div>
