<% heading_tag = local_assigns.fetch(:heading_tag, :h2) %>
<%= render Ui::CardComponent.new(class: 'h-full border-brand/25') do |card| %>
  <% if header.present? %>
    <% card.with_header do %>
      <div class="border-b border-line px-4 py-3">
        <%= content_tag heading_tag, header, class: 'mb-0 text-lg font-semibold text-ink' %>
      </div>
    <% end %>
  <% end %>
  <%= yield %>
<% end %>
