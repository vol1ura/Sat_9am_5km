<%= render Ui::CardComponent.new(
      hover: true,
      padding: false,
      class: "relative h-full overflow-hidden #{event.active ? 'border-brand/50' : 'border-danger'}",
    ) do %>
  <div class="relative overflow-hidden">
    <%= event_main_image_tag event, variant: :thumb, class: 'aspect-video w-full object-cover', alt: event.name, loading: 'lazy' %>
    <div class="absolute inset-x-0 top-0 flex w-full items-start justify-between bg-gradient-to-b from-black/40 to-transparent px-3 py-2">
      <span class="text-lg font-medium text-white"><%= event.name %></span>
    </div>
  </div>
  <div class="p-4 flex items-center justify-between">
    <p class="mb-0">
      <%= link_to "#{event.place} (#{event.town})", event_path(event.code_name), class: 'text-ink no-underline hover:text-brand after:absolute after:inset-0' %>
    </p>
    <%= render 'favorite_events/heart', event: %>
  </div>
<% end %>
