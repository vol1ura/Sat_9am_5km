<%= render Ui::CardComponent.new(
      hover: true,
      padding: false,
      class: "relative h-full overflow-hidden #{event.active ? 'border-brand/50' : 'border-danger'}",
    ) do %>
  <div class="relative overflow-hidden">
    <%= event_main_image_tag event, variant: :thumb, class: 'aspect-video w-full object-cover', alt: event.name, loading: 'lazy' %>
    <div class="absolute inset-x-0 top-0 flex w-full items-start justify-between bg-gradient-to-b from-black/60 to-transparent p-3">
      <span class="font-display text-xl font-semibold text-white drop-shadow-[0_1px_2px_rgba(0,0,0,0.8)]"><%= event.name %></span>
    </div>
  </div>
  <div class="p-4 flex items-center justify-between">
    <%= link_to "#{event.place} (#{event.town})", event_path(event.code_name), class: 'stretched-link text-ink no-underline hover:text-link' %>
    <%= render 'favorite_events/heart', event: %>
  </div>
<% end %>
