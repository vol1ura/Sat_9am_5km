<% head_info :title, t('.title') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1><%= t '.title' %></h1>
  <%= link_to t('.as_list'), events_path, class: 'btn btn-outline-primary' %>
</div>

<div
  class="events-map rounded border"
  data-controller="map"
  data-map-button-label-value="<%= t('events.index.details') %>"
  data-map-locate-label-value="<%= t('.locate') %>"
  data-map-locate-failed-label-value="<%= t('.locate_failed') %>"
  data-fullscreen-enter-label="<%= t('.fullscreen_enter') %>"
  data-fullscreen-exit-label="<%= t('.fullscreen_exit') %>"
></div>
