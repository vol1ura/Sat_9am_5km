<% head_info :title, t('.title', event: @event.name) %>
<% head_info :description, t('.description', event: @event.name) %>

<%= turbo_stream_from "live_results_from_#{@event.code_name}" %>

<nav aria-label="breadcrumb" class="mb-4 text-sm text-ink-muted">
  <ol class="flex flex-wrap items-center gap-1">
    <li><%= link_to t('.main_page'), root_path, class: 'text-brand hover:text-accent' %></li>
    <li class="before:px-1 before:content-['/']"><%= link_to @event.name, event_path(@event.code_name), class: 'text-brand hover:text-accent' %></li>
    <li class="before:px-1 before:content-['/'] text-ink" aria-current="page">
      <%= t('.live_results') %>
      <i class="fa-solid fa-satellite-dish ms-1 text-danger" style="animation: blink 1s infinite;"></i>
    </li>
  </ol>
</nav>

<div class="rounded-lg border border-info/20 bg-info-subtle px-4 py-3 text-info"><%= t('.disclaimer') %></div>

<%= render 'live_results_frame', live_results: @event.live_results || {} %>
