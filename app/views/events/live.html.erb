<% head_info :title, t('.title', event: @event.name) %>
<% head_info :description, t('.description', event: @event.name) %>

<%= turbo_stream_from "live_results_from_#{@event.code_name}" %>

<%= render 'shared/breadcrumbs', items: [
      { name: t('.main_page'), path: root_path },
      { name: @event.name, path: event_path(@event.code_name) },
      {
        name: safe_join([
          t('.live_results'),
          tag.i(class: 'fa-solid fa-satellite-dish ms-1 text-danger', style: 'animation: blink 1s infinite;'),
        ]),
        current: true,
      },
    ] %>

<div class="rounded-lg border border-info/20 bg-info-subtle px-4 py-3 text-info"><%= t('.disclaimer') %></div>

<%= render 'live_results_frame', live_results: @event.live_results || {} %>
