<tr id="position-summary-<%= position.role %>-<%= activity.id %>" class="table-active">
  <td colspan="2" class="py-2">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
      <span class="fw-semibold"><%= human_volunteer_role position.role %></span>
      <span class="d-flex align-items-center gap-2">
        <div class="progress" style="width: 100px; height: 8px;">
          <div
            class="progress-bar <%= filled >= position.number ? 'bg-success' : 'bg-primary' %>"
            style="width: <%= (100.0 * [filled, position.number].min / position.number).round %>%"
          ></div>
        </div>
        <span class="text-muted small text-nowrap">
          <%= t 'events.volunteering.slots_filled', filled: [filled, position.number].min, total: position.number %>
        </span>
      </span>
    </div>
  </td>
</tr>
