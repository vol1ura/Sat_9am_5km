<%= form_with url: admin_utilities_path(anchor: 'deleted-athlete'), method: :get do |f| %>
  <div style="margin-bottom: 12px; max-width: 300px">
    <%= f.label :athlete_id, t('admin.utilities.deleted_athlete.athlete_id') %>
    <%= f.number_field :athlete_id, value: params[:athlete_id], min: 1, required: true, step: 1 %>
  </div>
  <%= f.submit t('admin.utilities.deleted_athlete.submit') %>
<% end %>

<% if params[:athlete_id].present? %>
  <script>
    $(function () {
      setTimeout(function () {
        var $tabs = $('#active_admin_content .tabs');
        var $link = $tabs.find('a[href="#deleted-athlete"]');
        var index = $tabs.find('ul.nav-tabs a').index($link);
        if (index >= 0 && $tabs.data('ui-tabs')) {
          $tabs.tabs('option', 'active', index);
        }
      }, 0);
    });
  </script>
<% end %>
