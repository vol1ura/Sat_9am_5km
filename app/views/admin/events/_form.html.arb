# frozen_string_literal: true

active_admin_form_for [:admin, resource] do |f|
  f.inputs 'Активация' do
    input :active, input_html: { style: 'margin-bottom: 20px;' }
    if resource.active
      li class: 'boolean input optional' do
        text_node(
          label_tag('notify_cancellation') do
            safe_join(
              [
                check_box_tag('notify_cancellation', '1', false, style: 'margin-bottom: 20px;'),
                'уведомить участников об отмене',
              ],
            )
          end,
        )
      end
    end
    input :cancellation_reason
    input :auto_create_activities
  end

  f.inputs 'Геоданные' do
    input(
      :timezone,
      as: :searchable_select,
      include_blank: false,
      collection:
        ActiveSupport::TimeZone.all.map { |tz| ["#{tz.tzinfo.name} (UTC#{tz.formatted_offset})", tz.tzinfo.name] },
    )
    input :latitude
    input :longitude
    input :route_map, as: :file, input_html: { accept: 'application/json,.json' }, hint:
      if resource.route_map.attached? && resource.route_map.blob.persisted?
        link_to(resource.route_map.filename, route_map_event_path(resource.code_name), target: '_blank', rel: 'noopener')
      else
        'GeoJSON-файл (.json) со схемой трассы и точками'
      end
  end

  f.inputs 'Основные параметры' do
    input :country, include_blank: false
    input :name
    input :code_name if resource.new_record? || current_user.super_admin?
    input :town
    input :place
    input :place_description
    input(
      :description,
      as: :quill_editor,
      input_html: {
        data: {
          options: {
            modules: {
              toolbar: [
                %w[bold italic strike],
                %w[blockquote code-block],
                [{ list: 'ordered' }],
                ['link'],
                ['clean'],
              ],
            },
            placeholder: 'Описать кто и где проводит, особенности.',
            theme: 'snow',
          },
        },
      },
    )
    input :visible_order, input_html: { inputmode: 'numeric' }
    input :summer_image, as: :file, input_html: { accept: 'image/*' }, hint:
      if resource.summer_image.attached? && resource.summer_image.blob.persisted?
        image_tag resource.summer_image.variant(:thumb), class: 'img-badge'
      end
    input :winter_image, as: :file, input_html: { accept: 'image/*' }, hint:
      if resource.winter_image.attached? && resource.winter_image.blob.persisted?
        image_tag resource.winter_image.variant(:thumb), class: 'img-badge'
      end
  end

  f.actions
end
