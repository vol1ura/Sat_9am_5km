# frozen_string_literal: true

active_admin_form_for [:admin, resource] do |f|
  f.semantic_errors(*f.object.errors.attribute_names)

  f.inputs do
    li class: 'input required' do
      label 'Участник', class: 'label'
      render partial: '/admin/athlete_fields', locals: { resource: f.object.athlete, form: f }
    end
    input :rank, hint: 'Порядок отображения'
    localized_input :role
    input(
      :photo,
      as: :file,
      input_html: { accept: 'image/jpeg,image/png,image/webp' },
      required: true,
      hint: 'Поддерживаются файлы JPEG, PNG и WebP размером до 1 МБ',
    )
  end

  f.actions
end
