<%= turbo_frame_tag 'total_events' do %>
  <div class="grid grid-cols-1 gap-4 xl:grid-cols-2">
    <% if @results_by_event.present? %>
      <div class="data-table-inset min-w-0">
        <table class="data-table data-table--compact caption-top">
          <caption class="mb-2 font-semibold text-ink"><%= t('.finishes') %></caption>
          <thead>
            <tr data-controller="table-head">
              <th class="sortable" data-action="click->table-head#toggleSort">
                <span><%= t('.event') %></span>
                <span class="sort-arrow" aria-hidden="true"><i class="fa"></i></span>
              </th>
              <th class="sortable cell-num" data-action="click->table-head#toggleSort">
                <span><%= t('.count') %></span>
                <span class="sort-arrow" aria-hidden="true"><i class="fa"></i></span>
              </th>
              <th class="sortable cell-num" data-action="click->table-head#toggleSort">
                <span><%= t('.best_position') %></span>
                <span class="sort-arrow" aria-hidden="true"><i class="fa"></i></span>
              </th>
              <th class="sortable cell-num-strong whitespace-normal" data-action="click->table-head#toggleSort">
                <span><%= t('.best_time') %></span>
                <span class="sort-arrow" aria-hidden="true"><i class="fa"></i></span>
              </th>
            </tr>
          </thead>
          <tbody>
            <% @results_by_event.each do |result| %>
              <tr>
                <td sort-by="<%= result.event_name %>">
                  <%= link_to result.event_name, event_path(result.event_code_name), data: { turbo_frame: '_top' } %>
                </td>
                <td class="cell-num"><%= result.results_count %></td>
                <td class="cell-num"><%= result.best_position %></td>
                <td class="cell-num-strong" sort-by="<%= result.best_time %>"><%= Result.time_string result.best_time %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <% if @volunteering_by_event.present? %>
      <div class="data-table-inset min-w-0">
        <table class="data-table data-table--compact caption-top">
          <caption class="mb-2 font-semibold text-ink"><%= t('.volunteering') %></caption>
          <thead>
            <tr data-controller="table-head">
              <th class="sortable" data-action="click->table-head#toggleSort">
                <span><%= t('.event') %></span>
                <span class="sort-arrow" aria-hidden="true"><i class="fa"></i></span>
              </th>
              <th class="sortable cell-num" data-action="click->table-head#toggleSort">
                <span><%= t('.count') %></span>
                <span class="sort-arrow" aria-hidden="true"><i class="fa"></i></span>
              </th>
              <th class="sortable cell-num" data-action="click->table-head#toggleSort">
                <span><%= t('.roles') %></span>
                <span class="sort-arrow" aria-hidden="true"><i class="fa"></i></span>
              </th>
            </tr>
          </thead>
          <tbody>
            <% @volunteering_by_event.each do |volunteering| %>
              <tr>
                <td sort-by="<%= volunteering.event_name %>">
                  <%= link_to volunteering.event_name, event_path(volunteering.event_code_name), data: { turbo_frame: '_top' } %>
                </td>
                <td class="cell-num"><%= volunteering.vol_count %></td>
                <td class="cell-num"><%= volunteering.unique_roles_count %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
<% end %>
