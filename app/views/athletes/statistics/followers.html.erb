<%= turbo_frame_tag 'followers_list' do %>
  <% followers = @athlete.followers.includes(:going_to_event, user: { image_attachment: :blob }).order(:name) %>
  <% if followers.any? %>
    <div class="divide-y divide-line border-y border-line" id="followers">
      <%=
        render(
          partial: 'friendships/friend',
          collection: followers,
          locals: { is_friends_tab: false },
        )
      %>
    </div>
  <% else %>
    <p class="text-sm text-ink-muted"><%= t 'athletes.show.no_followers_list' %></p>
  <% end %>
<% end %>
