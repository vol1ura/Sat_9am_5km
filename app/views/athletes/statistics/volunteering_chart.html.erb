<%= turbo_frame_tag 'volunteering_chart' do %>
  <ul class="divide-y divide-line border-y border-line">
    <li class="py-3">
      <div class="flex min-w-0 flex-wrap items-center gap-3">
        <div class="min-w-0 sm:min-w-[150px] md:min-w-[200px]"><%= t '.h_index' %></div>
        <div><%= @h_index %></div>
      </div>
      <div class="text-sm text-ink-muted">
        <%= t '.h_index_explanation' %>
        <% if @h_index_missing_roles.positive? %>
          <br>
          <%= t '.h_index_missing_roles', count: @h_index_missing_roles %>
        <% end %>
      </div>
    </li>
    <li class="py-3">
      <div class="flex min-w-0 flex-wrap items-center gap-3">
        <div class="min-w-0 sm:min-w-[150px] md:min-w-[200px]"><%= t '.volunteering_coefficient' %></div>
        <div>
          <% if @total_results.zero? %>
            <i class="fa-solid fa-infinity"></i>
          <% else %>
            <%= (@volunteering.count * 10.0 / @total_results).round(1) %>
          <% end %>
        </div>
      </div>
      <div class="text-sm text-ink-muted">
        <%= t '.volunteering_coefficient_explanation' %>
      </div>
    </li>
  </ul>
  <div class="mt-2 flex min-w-0 flex-col items-center" data-controller="volunteer">
    <%=
      tag.div(
        class: 'mt-4 min-h-[380px] w-full min-w-0 max-w-3xl overflow-hidden',
        data: {
          controller: 'pie-chart',
          pie_chart_series_value: @role_counts.values,
          pie_chart_labels_value: @role_counts.keys.map { |role| human_volunteer_role(role) },
          pie_chart_chart_id_value: 'volunteering-roles-chart',
          pie_chart_unit_value: t('.roles_chart_unit'),
          pie_chart_total_label_value: t('.roles_chart_total'),
          pie_chart_title_value: t('.roles_chart_title'),
          pie_chart_height_value: 380,
          pie_chart_show_count_in_legend_value: true,
          pie_chart_error_value: t('.roles_chart_error'),
        },
      )
    %>
    <table class="hidden">
      <%
        history_stats = @volunteering
          .where(activity: { date: 5.months.ago.beginning_of_month.. })
          .group(:role, Arel.sql("date_part('month', date)"))
          .count
          .each_with_object({}) do |(k, v), h|
            h[k.first] ||= Array.new(6, 0)
            h[k.first][5 - ((Date.current.mon - k.last) % 12)] = v
          end
      %>
      <tbody>
        <% history_stats.each do |role, values| %>
          <tr data-volunteer-target="data">
            <th><%= human_volunteer_role role %></th>
            <% values.each do |value| %>
              <td><%= value %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
    <table class="hidden">
      <tbody>
        <%
          @role_counts
            .first(@h_index_target)
            .map do |role, count|
              {
                role: role,
                count: count,
                deficit: [@h_index_target - count, 0].max
              }
            end
            .each do |row|
        %>
              <tr
                data-volunteer-target="hdata"
                data-count="<%= row[:count] %>"
                data-deficit="<%= row[:deficit] %>">
                <th><%= human_volunteer_role row[:role] %></th>
              </tr>
        <% end %>
      </tbody>
    </table>
    <div class="w-full min-w-0 max-w-3xl overflow-hidden" data-volunteer-target="chart"></div>
    <div class="mt-4 w-full min-w-0 max-w-3xl overflow-hidden">
      <div
        class="mt-2 min-w-0 overflow-hidden"
        data-volunteer-target="hchart"
        data-h-index-target="<%= @h_index_target %>"
        data-h-index-title="<%= t '.h_index_chart_title' %>"
        data-h-index-tooltip="<%= t '.h_index_chart_tooltip' %>"
      ></div>
    </div>
  </div>
<% end %>
