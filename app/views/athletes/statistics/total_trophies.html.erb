<%= turbo_frame_tag 'total_trophies' do %>
  <div class="flex flex-wrap items-start gap-1">
    <% @athlete.trophies.includes(badge: { image_attachment: :blob }).order('date ASC NULLS FIRST').each do |trophy| %>
      <%
        awarding_date = trophy.badge.received_date || trophy.created_at
        trophy_link = link_to badge_path(trophy.badge), data: { turbo: false } do
          image_tag(
            trophy.badge.image.variant(:thumb),
            class: ['trophy', ('active' if awarding_date > 6.days.ago.beginning_of_day)].compact.join(' '),
            title: trophy.badge.name,
            alt: trophy.badge.name,
          )
        end
      %>
      <% (trophy.badge.record_kind? ? trophy.data.size : 1).times do %>
        <div class="trophy-container p-1">
          <%= trophy_link %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
