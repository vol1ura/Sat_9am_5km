<%
  athlete_name = @athlete.name || t('common.nobody')
  seconds_in_results = @athlete.stats.dig('results', 'seconds') || []
  total_results = @results.size
  six_days_ago = 6.days.ago.beginning_of_day
%>
<% head_info :description, t('.description', athlete_name:) %>

<%= render Ui::PageSubnavComponent.new(
  aria_label: t('athletes.show.profile_sections', default: 'Разделы профиля'),
  margin_class: 'mb-8',
  items: [
    *(total_results.positive? ? [{ label: t('athletes.show.tab_results'), href: '#panel-results', active: false }] : []),
    { label: t('athletes.show.tab_stats'), href: '#panel-stats', active: false },
    { label: t('athletes.show.tab_social'), href: '#panel-social', active: false },
    *(@total_vol.positive? ? [{ label: t('athletes.show.tab_volunteering'), href: '#panel-volunteering', active: false }] : []),
  ],
) %>

<section class="mb-8">
  <div class="flex flex-col items-center gap-6 sm:flex-row sm:items-start sm:justify-between">
    <div class="min-w-0 w-full flex-1 sm:w-auto">
      <h1 class="break-words font-display text-2xl font-bold text-ink sm:text-3xl">
        <%= head_info :title, athlete_name %>
      </h1>
      <% if @athlete.club %>
        <p class="mt-2 text-ink-muted">
          <%= link_to @athlete.club.name, club_path(@athlete.club.slug), class: 'text-brand hover:text-accent' %>
        </p>
      <% end %>
      <% if @athlete.going_to_event? %>
        <%= render Ui::BadgeComponent.new(variant: :success, class: 'mt-3') do %>
          <%= t 'friendships.friend.going_to', event: @athlete.going_to_event.name %>
        <% end %>
      <% end %>
      <div class="mt-4">
        <%= render 'friendships/button', athlete: @athlete %>
      </div>
    </div>
    <div class="relative w-fit shrink-0">
      <%= image_tag user_image_path(@athlete.user),
                    class: 'h-28 w-28 rounded-full border-4 border-brand/25 object-cover sm:h-32 sm:w-32',
                    alt: athlete_name,
                    title: athlete_name %>
      <button
        type="button"
        class="absolute -end-1 -top-1 flex h-10 w-10 items-center justify-center rounded-full border border-line bg-surface text-ink shadow-sm hover:bg-accent-subtle"
        data-controller="dialog"
        data-dialog-id-value="barcodeModal"
        data-action="click->dialog#open"
        aria-label="QR"
      >
        <i class="fa-solid fa-qrcode" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</section>

<section class="mb-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
  <%= render Ui::StatComponent.new(label: t('.total_results'), value: total_results, highlight: total_results.positive? && @results.first.date.to_date >= six_days_ago) %>
  <% if @personal_best %>
    <%= render Ui::StatComponent.new(label: t('.personal_best'), value: @personal_best.time_string, highlight: @personal_best.activity_date >= six_days_ago) %>
  <% end %>
  <%= render Ui::StatComponent.new(label: t('.total_trophies'), value: @total_trophies) %>
  <%= render Ui::StatComponent.new(label: t('.total_volunteering'), value: @total_vol) %>
  <%= render Ui::StatComponent.new(label: t('.friends'), value: @athlete.friends.size) %>
  <%= render Ui::StatComponent.new(label: t('.total_events'), value: @total_events_count) %>
</section>

<% if total_results.positive? %>
  <section id="panel-results" class="mb-10 scroll-mt-20 lg:scroll-mt-32">
    <%= render Ui::PageHeaderComponent.new(title: t('.results')) %>
    <div class="data-table-shell">
      <table class="data-table">
        <thead>
          <tr>
            <th class="cell-num-muted">#</th>
            <th><%= t '.table.date' %></th>
            <th class="cell-num-strong"><%= t '.table.time' %></th>
            <th class="hidden cell-num sm:table-cell"><%= t '.table.pace' %></th>
            <th class="hidden cell-num md:table-cell"><%= t '.table.place' %></th>
            <th><%= t '.table.event' %></th>
          </tr>
        </thead>
        <tbody>
          <%= render partial: 'result', collection: @results, locals: { total_results: } %>
        </tbody>
      </table>
    </div>
    <%= render '/expand_button' if total_results > 15 %>
  </section>
<% else %>
  <%= render Ui::EmptyComponent.new(title: t('.no_results')) %>
<% end %>

<section id="panel-stats" class="mb-10 scroll-mt-20 space-y-4 lg:scroll-mt-32">
  <%= render Ui::PageHeaderComponent.new(title: t('.statistics', default: 'Статистика')) %>
  <div class="grid gap-4 md:grid-cols-2">
    <% if total_results.positive? %>
      <%= render Ui::CardComponent.new do %>
        <h3 class="mb-3 font-display font-semibold text-ink"><%= t '.recent_results_chart' %></h3>
        <div data-controller="athlete">
          <div data-athlete-target="results"></div>
        </div>
      <% end %>
    <% end %>
    <%= render Ui::CardComponent.new do %>
      <h3 class="mb-3 font-display font-semibold text-ink"><%= t('.personal_best') %></h3>
      <%= turbo_frame_tag 'personal_bests', src: personal_bests_athlete_statistics_path(@athlete), loading: 'lazy' do %>
        <%= render '/loading_indicator' %>
      <% end %>
    <% end %>
    <%= render Ui::CardComponent.new do %>
      <h3 class="mb-3 font-display font-semibold text-ink"><%= t('.best_position') %></h3>
      <%= turbo_frame_tag 'best_position_absolute', src: best_position_absolute_athlete_statistics_path(@athlete), loading: 'lazy' do %>
        <%= render '/loading_indicator' %>
      <% end %>
    <% end %>
    <% if @athlete.personal_best_10k || @athlete.personal_best_half_marathon || @athlete.personal_best_marathon || @time_predictions.any? %>
      <%= render Ui::CardComponent.new do %>
        <h3 class="mb-3 font-display font-semibold text-ink"><%= t('.personal_bests_section') %></h3>
        <div class="data-table-inset">
          <table class="data-table data-table--compact">
            <thead>
              <tr>
                <th><%= t '.distance' %></th>
                <th><%= t '.pb' %></th>
                <th><%= t '.predicted_time' %></th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><%= t '.personal_best_10k' %></td>
                <td><%= @athlete.personal_best_10k %></td>
                <td><%= Result.time_string @time_predictions[10] %></td>
              </tr>
              <tr>
                <td><%= t '.personal_best_half_marathon' %></td>
                <td><%= @athlete.personal_best_half_marathon %></td>
                <td><%= Result.time_string @time_predictions[21.1] %></td>
              </tr>
              <tr>
                <td><%= t '.personal_best_marathon' %></td>
                <td><%= @athlete.personal_best_marathon %></td>
                <td><%= Result.time_string @time_predictions[42.2] %></td>
              </tr>
            </tbody>
          </table>
        </div>
      <% end %>
    <% end %>
    <%= render Ui::CardComponent.new(class: 'md:col-span-2') do %>
      <h3 class="mb-3 font-display font-semibold text-ink"><%= t('.total_trophies') %></h3>
      <% if @total_trophies.positive? %>
        <%= turbo_frame_tag 'total_trophies', src: total_trophies_athlete_statistics_path(@athlete), loading: 'lazy' do %>
          <%= render '/loading_indicator' %>
        <% end %>
      <% else %>
        <p class="text-sm text-ink-muted"><%= t('.no_trophies', default: '—') %></p>
      <% end %>
    <% end %>
  </div>

  <%= render Ui::CardComponent.new do %>
    <h3 class="mb-3 font-display font-semibold text-ink"><%= t('.total_events') %></h3>
    <%= turbo_frame_tag 'total_events', src: total_events_athlete_statistics_path(@athlete), loading: 'lazy' do %>
      <%= render '/loading_indicator' %>
    <% end %>
  <% end %>

  <% if @total_vol.positive? %>
    <%= render Ui::CardComponent.new do %>
      <h3 class="mb-3 font-display font-semibold text-ink"><%= t('.volunteering_chart', default: t('.total_volunteering')) %></h3>
      <%= turbo_frame_tag 'volunteering_chart', src: volunteering_chart_athlete_statistics_path(@athlete), loading: 'lazy' do %>
        <%= render '/loading_indicator' %>
      <% end %>
    <% end %>
  <% end %>
</section>

<section id="panel-social" class="mb-10 scroll-mt-20 space-y-4 lg:scroll-mt-32">
  <%= render Ui::PageHeaderComponent.new(title: t('.friends')) %>
  <div class="grid gap-4 md:grid-cols-2">
    <%= render Ui::CardComponent.new do %>
      <%= turbo_frame_tag 'friends_list', src: friends_athlete_statistics_path(@athlete), loading: 'lazy' do %>
        <%= render '/loading_indicator' %>
      <% end %>
    <% end %>
    <%= render Ui::CardComponent.new do %>
      <h3 class="mb-3 font-display font-semibold text-ink"><%= t('.followers') %></h3>
      <%= turbo_frame_tag 'followers_list', src: followers_athlete_statistics_path(@athlete), loading: 'lazy' do %>
        <%= render '/loading_indicator' %>
      <% end %>
    <% end %>
  </div>
</section>

<% if @total_vol.positive? %>
  <section id="panel-volunteering" class="mb-10 scroll-mt-20 lg:scroll-mt-32">
    <%= render Ui::PageHeaderComponent.new(title: t('.volunteering')) %>
    <div class="space-y-3">
      <% @volunteering.group_by(&:role).each do |role, volunteering_in_role| %>
        <details class="group rounded-lg border border-line bg-surface">
          <summary class="flex cursor-pointer list-none items-center gap-3 px-4 py-3 font-medium text-ink marker:content-none">
            <%= render Ui::BadgeComponent.new(variant: :brand) { volunteering_in_role.size.to_s } %>
            <%= human_volunteer_role role %>
            <i class="fa-solid fa-chevron-down ms-auto text-xs text-ink-muted transition-transform group-open:rotate-180" aria-hidden="true"></i>
          </summary>
          <ul class="divide-y divide-line border-t border-line px-4 py-2">
            <% volunteering_in_role.each do |vol| %>
              <li class="py-2 text-sm">
                <%= link_to l(vol.activity.date), vol.activity, class: 'text-brand hover:text-accent' %>
                —
                <%= link_to vol.activity.event_name, event_path(vol.activity.event.code_name), class: 'text-ink-muted hover:text-brand' %>
              </li>
            <% end %>
          </ul>
        </details>
      <% end %>
    </div>
  </section>
<% end %>

<%= render 'shared/barcode_modal', code: @athlete.code, barcode: @barcode %>

<%= render Ui::ModalComponent.new(id: 'minute-bingo-modal', size: :md) do |modal| %>
  <% modal.with_title { t('.mission_minute_bingo') } %>
  <table class="mx-auto border-separate border-spacing-1">
    <% 6.times.each do |row| %>
      <tr>
        <% 10.times.each do |col| %>
          <% x = (row * 10) + col %>
          <td class="<%= x.in?(seconds_in_results) ? 'rounded-full bg-brand-fill px-1.5 text-brand-fg' : 'text-ink-muted' %> text-center text-sm tabular-nums">
            <%= format '%02d', x %>
          </td>
        <% end %>
      </tr>
    <% end %>
  </table>
  <div class="mt-4 flex justify-end">
    <%= render Ui::ButtonComponent.new(variant: :secondary, type: 'button', data: { action: 'dialog#close' }, label: t('.close')) %>
  </div>
<% end %>
