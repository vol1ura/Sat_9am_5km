<% percent = 10.0 * seconds_in_results_count / 6 %>
<button
  type="button"
  class="progress-pie-badge<%= ' ppb-gt-50' if percent > 50 %>"
  data-controller="dialog"
  data-dialog-id-value="minute-bingo-modal"
  data-action="click->dialog#open"
  aria-label="<%= t('.catch_them_all') %>"
>
  <span class="ppb-progress" aria-hidden="true">
    <span class="ppb-progress-fill" style="transform: rotate(<%= 360 * percent / 100 %>deg);"></span>
  </span>
  <span class="ppb-info">
    <span class="ppb-info-wrapper">
      <span class="ppb-info-text">
        <%= seconds_in_results_count %> <%= t '.from_minute' %> — <%= t '.catch_them_all' %>!
      </span>
    </span>
  </span>
</button>
