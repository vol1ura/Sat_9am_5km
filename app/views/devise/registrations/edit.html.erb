<h1>Настройки</h1>

<%= form_for resource, as: resource_name, url: user_registration_path(resource_name), html: { method: :put }, data: { turbo: false } do |f| %>
  <%= render 'devise/shared/error_messages', resource: %>

  <div class="mt-2">
    <%= f.label :first_name, class: 'block text-sm font-medium text-ink' %><br>
    <%= f.text_field :first_name, class: form_input_class %>
  </div>

  <div class="mt-2">
    <%= f.label :last_name, class: 'block text-sm font-medium text-ink' %><br>
    <%= f.text_field :last_name, class: form_input_class %>
  </div>

  <%= f.fields_for :athlete, f.object.athlete do |athlete_form| %>
    <%= athlete_form.label :club, class: 'block text-sm font-medium text-ink' %>
    <%= athlete_form.collection_select :club_id, Club.order(:name), :id, :name, { include_blank: 'Нет клуба' },
          class: form_input_class %>
  <% end %>

  <div class="my-3">
    <%= render Ui::ButtonComponent.new(variant: :primary, type: 'submit', label: 'Обновить') %>
  </div>
<% end %>

