<% head_info :description, t('.description') %>

<div class="page-container page-container--narrow">
  <%=
    render(Ui::PageHeaderComponent.new(
      title: head_info(:title, t('.title')),
      description: t('.description'),
    ))
  %>

  <div class="flex flex-col gap-4">
    <% if user_signed_in? %>
      <div class="rounded-lg border border-warning/25 bg-warning-subtle/40 px-4 py-3 text-sm text-warning" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i>
        <%= t '.sign_out_warning' %>
      </div>
    <% end %>

    <%= render Ui::CardComponent.new do %>
      <%= form_for resource,
          as: resource_name,
          url: confirmation_path(resource_name),
          html: { method: :post, data: { turbo: false } } do |f| %>
        <div class="flex flex-col gap-2">
          <%= render 'devise/shared/error_messages', resource: %>

          <div>
            <%= f.label :email, class: 'mb-1 block text-sm font-medium text-ink' %>
            <%=
              f.email_field(
                :email,
                autofocus: true,
                autocomplete: :email,
                inputmode: :email,
                value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email),
                class: form_input_class,
                placeholder: t('.your_email'),
              )
            %>
          </div>

          <div class="flex flex-col gap-2 sm:flex-row sm:justify-start">
            <%= render Ui::ButtonComponent.new(variant: :primary, type: 'submit') do %>
              <i class="fa-solid fa-envelope" aria-hidden="true"></i>
              <%= t '.send_confirmation' %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>

    <%= render 'devise/shared/links' %>
  </div>
</div>
