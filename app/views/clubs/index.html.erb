<% head_info :description, t('.description') %>

<%= render 'ratings/hub_tabs' %>

<%= render Ui::PageHeaderComponent.new(
  title: head_info(:title, t('navbars.top.club_ratings')),
  description: safe_join([
    t('.how_to_add_new_club_html', mail: ENV.fetch('INFO_EMAIL')),
    tag.br,
    t('.avg_results_per_athlete_description_html'),
    tag.br,
    t('.avg_volunteering_per_athlete_description_html'),
  ]),
) %>

<div class="mb-3 max-w-xl">
  <%= search_form_for @q, url: clubs_path, method: :get do |f| %>
    <div class="flex gap-2">
      <%= f.search_field :name_i_cont,
            class: form_input_class,
            placeholder: t('.search_placeholder') %>
      <%= render Ui::ButtonComponent.new(variant: :secondary, size: :sm, href: clubs_path, class: 'shrink-0') do %>
        <i class="fa-solid fa-times"></i>
      <% end %>
      <%= render Ui::ButtonComponent.new(variant: :secondary, size: :sm, type: 'submit', class: 'shrink-0') do %>
        <i class="fa-solid fa-magnifying-glass"></i>
        <%= t '.search_button' %>
      <% end %>
    </div>
  <% end %>
</div>

<div class="data-table-shell">
  <table class="data-table sm:table-fixed">
    <thead>
      <tr>
        <th><%= sort_link @q, :name, t('.name') %></th>
        <th class="cell-num"><%= sort_link @q, :athletes_count, t('.athletes') %></th>
        <th class="cell-num-strong"><%= sort_link @q, :results_count, t('.results') %></th>
        <th class="cell-num"><%= sort_link @q, :avg_results_per_athlete, t('.avg_results_per_athlete') %></th>
        <th class="cell-num"><%= sort_link @q, :avg_total_time, t('.avg_result') %></th>
        <th class="cell-num"><%= sort_link @q, :best_total_time, t('.best_result') %></th>
        <th class="cell-num-strong"><%= sort_link @q, :volunteering_count, t('.volunteering') %></th>
        <th class="cell-num"><%= sort_link @q, :avg_volunteering_per_athlete, t('.avg_volunteering_per_athlete') %></th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: 'club', collection: @clubs %>
    </tbody>
  </table>
</div>

<div class="mt-4">
  <%= paginate @clubs, window: 2 %>
</div>
