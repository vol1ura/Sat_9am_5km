<% head_info :og_image, url_for(@club.logo) if @club.logo.attached? %>
<% head_info :description, t('.description', club: @club.name) %>

<%= render 'shared/breadcrumbs', items: [
      { name: t('.main_page'), path: root_path },
      { name: t('.clubs'), path: clubs_path },
      { name: @club.name, current: true },
    ] %>

<%= render Ui::PageHeaderComponent.new(
  title: head_info(:title, @club.name),
  description: sanitized_text(@club.description),
) do |header| %>
  <% if @club.logo.attached? %>
    <% header.with_actions do %>
      <%= image_tag @club.logo.variant(:web), class: 'img-club', alt: @club.name %>
    <% end %>
  <% end %>
<% end %>

<section class="mb-8 grid grid-cols-1 gap-3 sm:grid-cols-3">
  <%= render Ui::StatComponent.new(label: t('.athletes_count'), value: @athletes.load.size) %>
  <%= render Ui::StatComponent.new(label: t('.results_count'), value: @total_results_count) %>
  <%= render Ui::StatComponent.new(label: t('.volunteering_count'), value: @total_volunteering_count) %>
</section>

<ul class="mb-8 divide-y divide-line border-y border-line">
  <li class="flex items-center gap-3 py-3">
    <%= render Ui::BadgeComponent.new(variant: :brand, label: tag.i(class: 'fa-solid fa-trophy', aria: { hidden: true })) %>
    <%= link_to t('.best_results'), results_ratings_path(club_id: @club.id) %>
  </li>
  <li class="flex items-center gap-3 py-3">
    <%= render Ui::BadgeComponent.new(variant: :brand, label: tag.i(class: 'fa-solid fa-person-running', aria: { hidden: true })) %>
    <%= link_to t('.last_week_activities'), last_week_club_path(@club.slug) %>
  </li>
</ul>

<section>
  <%= render Ui::SectionHeaderComponent.new title: t('clubs.index.athletes') %>

  <div class="data-table-shell">
    <table class="data-table">
      <thead>
        <tr data-controller="table-head">
          <th class="sortable" data-action="click->table-head#toggleSort">
            <span><%= t '.name' %></span>
            <span class="sort-arrow" aria-hidden="true"><i class="fa fa-caret-down"></i></span>
          </th>
          <th class="sortable cell-center" data-action="click->table-head#toggleSort">
            <span><%= t '.activities' %></span>
            <span class="sort-arrow" aria-hidden="true"><i class="fa"></i></span>
          </th>
          <th class="sortable hidden-on-phone cell-center" data-action="click->table-head#toggleSort">
            <span><%= t '.volunteering' %></span>
            <span class="sort-arrow" aria-hidden="true"><i class="fa"></i></span>
          </th>
          <th class="sortable cell-num" data-action="click->table-head#toggleSort">
            <span><%= t '.personal_best' %></span>
            <span class="sort-arrow" aria-hidden="true"><i class="fa"></i></span>
          </th>
        </tr>
      </thead>
      <tbody>
        <%= render partial: 'athlete', collection: @athletes, cached: ->(athlete) { locale_cache_key(athlete) } %>
      </tbody>
    </table>
  </div>
</section>
