<% going_to_event_id = current_user&.athlete&.going_to_event_id %>
<% if going_to_event_id.blank? && current_user&.athlete %>
  <p><%= t '.going_to_event' %></p>
  <%= button_to event_going_to_path(@event.code_name),
                method: :post,
                class: 'inline-flex items-center justify-center gap-2 rounded-md border border-line bg-surface-elevated px-4 py-2 text-sm font-medium text-success transition-opacity hover:bg-success-subtle' do %>
    <%= t '.going', date: l(Date.current.next_occurring(:saturday), format: :brief) %>
  <% end %>
<% elsif going_to_event_id == @event.id %>
  <p><%= t '.already_going' %></p>
  <%= button_to event_going_to_path(@event.code_name),
                method: :delete,
                class: 'inline-flex items-center justify-center gap-2 rounded-md border border-line bg-surface-elevated px-4 py-2 text-sm font-medium text-danger transition-opacity hover:bg-danger-subtle',
                form: { data: { turbo_confirm: t('.confirm_cancel') } } do %>
    <%= t '.cancel', date: l(Date.current.next_occurring(:saturday), format: :brief) %>
  <% end %>
  <p class="py-3 font-light text-ink-muted"><%= t '.reset_going_to' %></p>
<% end %>
