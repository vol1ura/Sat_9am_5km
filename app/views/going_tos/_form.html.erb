<%
  going_to_event_id = current_user&.athlete&.going_to_event_id
  next_saturday_date = l(Date.current.next_occurring(:saturday), format: :brief)
%>
<% if going_to_event_id.blank? && current_user&.athlete %>
  <p class="mb-2"><%= t '.going_to_event' %></p>
  <%= form_with url: event_going_to_path(@event.code_name), method: :post do %>
    <%= render Ui::ButtonComponent.new(
          variant: :secondary,
          type: 'submit',
          label: t('.going', date: next_saturday_date)
        ) %>
  <% end %>
<% elsif going_to_event_id == @event.id %>
  <p class="mb-2"><%= t '.already_going' %></p>
  <%= form_with url: event_going_to_path(@event.code_name), method: :delete, data: { turbo_confirm: t('.confirm_cancel') } do %>
    <%= render Ui::ButtonComponent.new(
          variant: :secondary,
          type: 'submit',
          class: 'text-danger hover:bg-danger-subtle',
          label: t('.cancel', date: next_saturday_date)
        ) %>
  <% end %>
  <p class="py-3 font-light text-ink-muted"><%= t '.reset_going_to' %></p>
<% end %>
