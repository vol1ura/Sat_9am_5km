<li class="nav-item dropdown" data-controller="dropdown">
  <%=
    button_tag(
      type: 'button',
      class: "nav-link dropdown-toggle #{'active' if params[:controller] == 'pages' && params[:page] == 'feedback'}",
      'data-bs-toggle' => 'dropdown',
      'aria-expanded' => 'false',
      'data-dropdown-target' => 'toggle',
    ) do
  %>
    <% if with_icon %>
      <span class="fa-li"><i class="fa-solid fa-address-card"></i></span>
    <% end %>
    <%= t('.title') %>
  <% end %>
  <ul class="dropdown-menu" data-dropdown-target="menu">
    <li><%= link_to t('.feedback'), page_path(page: 'feedback'), class: "dropdown-item #{'active' if params[:page] == 'feedback'}" %></li>
    <li><%= external_link_to t('.vk'), 'https://vk.com/s95ru', class: 'dropdown-item' %></li>
    <li><%= external_link_to t('.telegram'), Rails.configuration.telegram[top_level_domain], class: 'dropdown-item' %></li>
    <li><%= external_link_to t('.email'), "mailto:#{ENV.fetch('INFO_EMAIL')}", class: 'dropdown-item' %></li>
  </ul>
</li>
