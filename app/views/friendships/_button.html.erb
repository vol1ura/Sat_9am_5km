<% if current_user.nil? %>
  <div id="friendship-button">
    <%= render Ui::ButtonComponent.new(variant: :secondary, size: :sm, href: new_user_session_path) do %>
      <i class="fa-solid fa-user-plus"></i>
      <%= t '.add_friend' %>
    <% end %>
  </div>
<% elsif current_user.athlete != athlete %>
  <div id="friendship-button">
    <% if current_user.athlete.friend?(athlete) %>
      <div class="mb-2">
        <%= render Ui::BadgeComponent.new(variant: :success) do
          athlete.friend?(current_user.athlete) ? t('.your_mutual_friend') : t('.your_friend')
        end %>
      </div>
    <% else %>
      <%= form_with url: friendships_path(friend_id: athlete), class: 'inline', data: { turbo: true } do %>
        <%= render Ui::ButtonComponent.new(variant: :secondary, size: :sm, type: 'submit') do %>
          <i class="fa-solid fa-user-plus"></i>
          <%= t '.add_friend' %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
